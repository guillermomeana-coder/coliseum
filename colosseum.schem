      <span>›</span>
      <a href="https://minecraftschem.com/builds" class="vp-post-type-badge" style="text-decoration:none;">Builds</a>
      <span>›</span>
      <a href="https://minecraftschem.com/builds/arenas" style="color:inherit;text-decoration:none;">Arenas</a>
    </nav>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://minecraftschem.com/"},{"@type":"ListItem","position":2,"name":"Builds","item":"https://minecraftschem.com/builds"},{"@type":"ListItem","position":3,"name":"Arenas","item":"https://minecraftschem.com/builds/arenas"},{"@type":"ListItem","position":4,"name":"Colosseum","item":"https://minecraftschem.com/content/1216/colosseum"}]}</script>

    <!-- Stats inline -->
    <div class="vp-stats-inline">
      <span><i class="fa-solid fa-eye"></i> <strong>2,428</strong> views</span>
      <span><i class="fa-solid fa-eye"></i> <strong>1</strong> today</span>
      <span><i class="fa-solid fa-download"></i> <strong>406</strong> downloads</span>
      <span><i class="fa-solid fa-download"></i> <strong>1</strong> today</span>
      <span><i class="fa-solid fa-heart"></i> <strong>4</strong></span>
      <span><i class="fa-solid fa-star"></i> <strong>1</strong></span>
    </div>

