    <script src="https://unpkg.com/nbt-js@latest/nbt.js"></script>    <!-- WEB_ROOT e fix automatico per tutti i fetch/XHR con URL relative -->
    <script>
    var WEB_ROOT = '/';

    // Risolve URL relativi (es. 'post_actions.php') aggiungendo WEB_ROOT
    // Non tocca URL già assoluti (http/https) o con slash iniziale (già assoluti)
    function _resolveUrl(url) {
        if (typeof url !== 'string') return url;
        if (url.startsWith('http') || url.startsWith('/') ||
            url.startsWith('data:') || url.startsWith('blob:') ||
            url.startsWith('#') || url.startsWith('?')) return url;
        return WEB_ROOT + url;
    }

    // Override fetch
    (function() {
        var _origFetch = window.fetch;
        window.fetch = function(resource, init) {
            return _origFetch.call(this, _resolveUrl(resource), init);
        };
    })();

    // Override XMLHttpRequest.open
    (function() {
        var _origOpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function(method, url) {
            var args = Array.prototype.slice.call(arguments);
            args[1] = _resolveUrl(url);
            return _origOpen.apply(this, args);
        };
    })();
    </script>
    <!-- Apply saved theme before paint (prevents flash) -->
    <script>
        (function() {
            var saved = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', saved);
        })();
    </script>
    <!-- Main search bar autocomplete -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const input = document.getElementById('main-search-input');
        const box   = document.getElementById('main-search-suggestions');
        if (!input || !box) return;
        let timer;
        input.addEventListener('input', function() {
            clearTimeout(timer);
            const val = this.value.trim();
            if (val.length < 2) { box.style.display = 'none'; return; }
            timer = setTimeout(() => {
                fetch('/search.php?autocomplete_posts=1&q=' + encodeURIComponent(val))
                    .then(r => r.json())
                    .then(posts => {
                        if (!posts.length) { box.style.display = 'none'; return; }
                        box.innerHTML = posts.map(p =>
                            `<a href="/search.php?q=${encodeURIComponent(p.title)}"
                                style="display:block;padding:9px 14px;color:var(--text);text-decoration:none;font-size:0.9rem;border-bottom:1px solid var(--border);"
                                onmouseover="this.style.background='var(--surface-2)'"
                                onmouseout="this.style.background=''">${p.title}</a>`
                        ).join('');
                        box.style.display = 'block';
                    }).catch(() => {});
            }, 220);
        });
        document.addEventListener('click', function(e) {
            if (!input.contains(e.target) && !box.contains(e.target)) box.style.display = 'none';
        });
        input.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') box.style.display = 'none';
        });
    });
    </script>
    <!-- GA4 Download conversion tracking -->
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        document.addEventListener('click', function(e) {
            var link = e.target.closest('a[href*="download.php"]');
            if (!link) return;
            var href = link.getAttribute('href') || '';
            // Skip 3D viewer requests (view=1)
            if (href.indexOf('view=1') !== -1) return;
            var params = new URLSearchParams(href.split('?')[1] || '');
            var postId = params.get('id') || '';
            var dlType = params.get('type') || 'direct';
            if (typeof gtag === 'function') {
                gtag('event', 'download_click', {
                    'transport_type': 'beacon',
                    'post_id': postId,
                    'download_type': dlType
                });
            }
        });
    });
    </script>
