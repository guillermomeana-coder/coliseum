<!DOCTYPE html>
<html lang="en" data-theme="dark">
<style>
.header-bottom-content {
    display: flex;
    align-items: center;
    gap: 20px;

}
.home-link {
    color: white;
}
.nav-links {
    margin-left: auto; /* spinge il nav a destra */
}

.header-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
}
/* ── Nav "More" dropdown ───────────────────────────── */
.nav-more { position: relative; display: inline-block; }
.nav-more-menu {
    display: none; position: absolute; top: 100%; left: 0;
    background: var(--nav-bg); border: 1px solid var(--border);
    border-radius: 8px; min-width: 170px; z-index: 300;
    box-shadow: 0 8px 24px rgba(0,0,0,0.45); padding: 4px 0; margin-top: 2px;
}
.nav-more:hover .nav-more-menu, .nav-more.open .nav-more-menu { display: block; }
.nav-more-menu a { display: block; padding: 9px 16px; white-space: nowrap; }
.nav-more-menu a:hover { background: var(--surface-2, rgba(255,255,255,0.06)); }
.header-top-right {
    display: flex;
    gap: 8px;
    align-items: flex-start;
}
/* ── Notification bell ─────────────────────────────── */
#notif-btn {
    background: none; border: none;
    color: var(--text); font-size: 1.0rem;
    cursor: pointer; padding: 4px 5px; line-height: 1;
    opacity: 0.75; transition: opacity 0.2s, color 0.2s;
    position: absolute; top: 5px; right: 5px;
}
#notif-btn:hover { opacity: 1; color: var(--teal); }
#notif-badge {
    position: absolute; top: -3px; right: -4px;
    background: #e74c3c; color: #fff;
    font-size: 0.58rem; font-weight: 700;
    min-width: 15px; height: 15px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    padding: 0 3px; pointer-events: none;
    font-family: 'Outfit', sans-serif; line-height: 1;
}
.notif-item {
    display: flex; gap: 10px; padding: 9px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text); text-decoration: none;
    transition: background 0.15s;
}
.notif-item:last-child { border-bottom: none; }
.notif-item--unread { filter: brightness(1.1); }
.notif-avatar { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; flex-shrink: 0; margin-top: 2px; }
.notif-text { flex: 1; font-size: 0.8em; line-height: 1.45; }
.notif-text b { color: var(--text-strong); font-weight: 600; }
.notif-time { font-size: 0.72em; color: var(--text-muted); margin-top: 3px; }
.notif-empty { padding: 22px 14px; text-align: center; color: var(--text-muted); font-size: 0.84rem; }
/* Gradient shades — same colors as feed */
.notif-item.notif-ev-post    { background:linear-gradient(90deg,rgba(50,236,195,0.20) 0%,rgba(50,236,195,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-edit    { background:linear-gradient(90deg,rgba(240,165,0,0.22)   0%,rgba(240,165,0,0.05)   55%,transparent 100%); }
.notif-item.notif-ev-comment { background:linear-gradient(90deg,rgba(91,141,238,0.22)  0%,rgba(91,141,238,0.05)  55%,transparent 100%); }
.notif-item.notif-ev-list    { background:linear-gradient(90deg,rgba(168,85,247,0.22)  0%,rgba(168,85,247,0.05)  55%,transparent 100%); }
.notif-item.notif-ev-follow  { background:linear-gradient(90deg,rgba(34,197,94,0.22)   0%,rgba(34,197,94,0.05)   55%,transparent 100%); }
.notif-item.notif-ev-ticket  { background:linear-gradient(90deg,rgba(239,68,68,0.22)   0%,rgba(239,68,68,0.05)   55%,transparent 100%); }
.notif-item.notif-ev-like    { background:linear-gradient(90deg,rgba(248,113,113,0.22) 0%,rgba(248,113,113,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-fav     { background:linear-gradient(90deg,rgba(245,158,11,0.22)  0%,rgba(245,158,11,0.05)  55%,transparent 100%); }
.notif-item.notif-ev-post:hover    { background:linear-gradient(90deg,rgba(50,236,195,0.32) 0%,rgba(50,236,195,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-edit:hover    { background:linear-gradient(90deg,rgba(240,165,0,0.32)  0%,rgba(240,165,0,0.09)  55%,transparent 100%); }
.notif-item.notif-ev-comment:hover { background:linear-gradient(90deg,rgba(91,141,238,0.32) 0%,rgba(91,141,238,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-list:hover    { background:linear-gradient(90deg,rgba(168,85,247,0.32) 0%,rgba(168,85,247,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-follow:hover  { background:linear-gradient(90deg,rgba(34,197,94,0.32)  0%,rgba(34,197,94,0.09)  55%,transparent 100%); }
.notif-item.notif-ev-ticket:hover  { background:linear-gradient(90deg,rgba(239,68,68,0.32)  0%,rgba(239,68,68,0.09)  55%,transparent 100%); }
.notif-item.notif-ev-like:hover    { background:linear-gradient(90deg,rgba(248,113,113,0.32)0%,rgba(248,113,113,0.09)55%,transparent 100%); }
.notif-item.notif-ev-fav:hover     { background:linear-gradient(90deg,rgba(245,158,11,0.32) 0%,rgba(245,158,11,0.09) 55%,transparent 100%); }
/* Contest events — colori distinti */
.notif-item.notif-ev-ccreated { background:linear-gradient(90deg,rgba(6,182,212,0.22)  0%,rgba(6,182,212,0.05)  55%,transparent 100%); }
.notif-item.notif-ev-cjoined  { background:linear-gradient(90deg,rgba(132,204,22,0.22) 0%,rgba(132,204,22,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-centry   { background:linear-gradient(90deg,rgba(99,102,241,0.22) 0%,rgba(99,102,241,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-cwon     { background:linear-gradient(90deg,rgba(249,115,22,0.22) 0%,rgba(249,115,22,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-cemblem  { background:linear-gradient(90deg,rgba(217,70,239,0.22) 0%,rgba(217,70,239,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-cjudge   { background:linear-gradient(90deg,rgba(20,184,166,0.22) 0%,rgba(20,184,166,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-cvoting  { background:linear-gradient(90deg,rgba(244,63,94,0.22)  0%,rgba(244,63,94,0.05)  55%,transparent 100%); }
.notif-item.notif-ev-ccreated:hover { background:linear-gradient(90deg,rgba(6,182,212,0.32)  0%,rgba(6,182,212,0.09)  55%,transparent 100%); }
.notif-item.notif-ev-cjoined:hover  { background:linear-gradient(90deg,rgba(132,204,22,0.32) 0%,rgba(132,204,22,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-centry:hover   { background:linear-gradient(90deg,rgba(99,102,241,0.32) 0%,rgba(99,102,241,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-cwon:hover     { background:linear-gradient(90deg,rgba(249,115,22,0.32) 0%,rgba(249,115,22,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-cemblem:hover  { background:linear-gradient(90deg,rgba(217,70,239,0.32) 0%,rgba(217,70,239,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-cjudge:hover   { background:linear-gradient(90deg,rgba(20,184,166,0.32) 0%,rgba(20,184,166,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-cvoting:hover  { background:linear-gradient(90deg,rgba(244,63,94,0.32)  0%,rgba(244,63,94,0.09)  55%,transparent 100%); }
.notif-item.notif-ev-message  { background:linear-gradient(90deg,rgba(37,211,102,0.22) 0%,rgba(37,211,102,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-message:hover { background:linear-gradient(90deg,rgba(37,211,102,0.32) 0%,rgba(37,211,102,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-gjoin    { background:linear-gradient(90deg,rgba(147,51,234,0.22) 0%,rgba(147,51,234,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-gjoin:hover   { background:linear-gradient(90deg,rgba(147,51,234,0.32) 0%,rgba(147,51,234,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-gfollow  { background:linear-gradient(90deg,rgba(14,165,233,0.22) 0%,rgba(14,165,233,0.05) 55%,transparent 100%); }
.notif-item.notif-ev-gfollow:hover { background:linear-gradient(90deg,rgba(14,165,233,0.32) 0%,rgba(14,165,233,0.09) 55%,transparent 100%); }
.notif-item.notif-ev-levelup  { background:linear-gradient(90deg,rgba(250,204,21,0.24) 0%,rgba(250,204,21,0.06) 55%,transparent 100%); }
.notif-item.notif-ev-levelup:hover { background:linear-gradient(90deg,rgba(250,204,21,0.34) 0%,rgba(250,204,21,0.10) 55%,transparent 100%); }
</style>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1500">
    <style>
      /* Il contenuto (griglia gridstack) è largo ~1220px: se la viewport è più
         stretta, header/footer devono comunque coprire tutta la larghezza,
         altrimenti restano corti e resta una fascia vuota a destra. */
      html, body { min-width: 1500px; }
      body { position: relative; }
    </style>
    <script>
    // Auto-dezoom: alcuni browser mobile ricordano lo zoom della sessione precedente.
    (function () {
        function fit() {
            try {
                var W = 1500;
                var land = window.matchMedia && window.matchMedia('(orientation: landscape)').matches;
                var avail = window.screen ? (land ? Math.max(screen.width, screen.height)
                                                  : Math.min(screen.width, screen.height)) : 0;
                if (!avail || avail >= W) return;            // desktop: non toccare nulla
                var scale = Math.round((avail / W) * 1000) / 1000;
                var m = document.querySelector('meta[name="viewport"]');
                if (m) m.setAttribute('content', 'width=' + W + ', initial-scale=' + scale + ', maximum-scale=5, user-scalable=yes');
            } catch (e) {}
        }
        fit();
        window.addEventListener('orientationchange', function () { setTimeout(fit, 250); });

        // Desktop: i browser ignorano il meta viewport, quindi con una finestra
        // più stretta di 1500px il contenuto verrebbe tagliato. Riduco lo zoom
        // della pagina in proporzione, come fa il "fit to width" del mobile.
        var W = 1500, tmr = null;
        function deskFit() {
            try {
                var w = window.innerWidth || 0;
                if (!w) return;
                var el = document.documentElement;
                if (w >= W) { if (el.style.zoom) el.style.zoom = ''; return; }
                var z = Math.max(0.35, Math.round((w / W) * 1000) / 1000);
                if (el.style.zoom !== String(z)) el.style.zoom = z;
            } catch (e) {}
        }
        function deskFitSoon() { clearTimeout(tmr); tmr = setTimeout(deskFit, 60); }
        if (document.readyState !== 'loading') deskFit();
        else document.addEventListener('DOMContentLoaded', deskFit);
        window.addEventListener('resize', deskFitSoon);
    })();
    </script>
