<!-- Materialize for 3D viewer settings UI -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>

<!-- Modal per Visualizzatore 3D (completo con settings panel, build info e fix stili) -->
<div id="3d-viewer-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.95); z-index:10000;">
    <div style="position:relative; width:100%; height:100%;">
       
        <!-- Loading overlay -->
        <div id="loading-overlay" style="position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);display:none;justify-content:center;align-items:center;z-index:10;">
            <div style="border:4px solid rgba(255,255,255,0.3);border-top:4px solid #fff;border-radius:50%;width:50px;height:50px;animation:spin 1s linear infinite;"></div>
        </div>
       
        <!-- Il repo creerà il canvas qui dentro -->
        <div id="viewer" style="width:100%; height:100%;"></div>
       
        <!-- Elementi per sliders e material list -->
        <div id="sliders" hidden style="padding:12px 20px; position: absolute; bottom: 10px; left: 10px; color: white;">Height Range: </div>
        <button id="materialListButton" hidden style="position: absolute; top: 10px; left: 10px; padding: 8px;"><span class="material-icons">Block List</span></button>
        <div id="materialList" hidden style="position: absolute; top: 50px; left: 10px; width: 400px; column-count: 2; max-height: 80vh; background: #000; padding: 10px; color: white; overflow: auto;"></div>
        
        <!-- Build info -->
        <div id="build-info" hidden style="position: absolute; top: 10px; left: 500px; background: rgba(0,0,0,0.5); padding: 10px; border-radius: 5px; z-index: 10; color: white;"></div>
        
        <!-- Bottone chiudi modal -->
        <button onclick="close3DViewer()" style="position:absolute; top:15px; right:15px; padding:12px 20px; background:#e74c3c; color:white; border:none; border-radius:6px; cursor:pointer; font-weight:bold; ">Close</button>
        
        <!-- open settings panel button -->
        <a href="javascript:void(0)" id="settings-button" class="openbtn" onclick="openSettings()" style="position: absolute; top: 10px; right: 125px; font-size: 36px; color: white;"><i class="fa fa-cog"></i></a>
      
        <!-- Settings panel -->
        <div id="settings-panel" class="side-nav" style="height: 100%; width: 0; position: fixed; z-index: 1; top: 0; right: 0; opacity: 90%; background-color: #111; overflow-x: hidden; padding-top: 60px; transition: 0.5s;">
            <!-- close button -->
            <a href="javascript:void(0)" class="closebtn" onclick="closeSettings()" style="position: absolute; top: 0; right: 25px; font-size: 36px; margin-left: 50px; color: white;">&times;</a>
            <!-- TODO: Add a way to generate all this automagically -->
            <p>Controls</p>
            <div class="settings-section" style="margin-bottom: 20px; display: grid; width: fit-content; margin:auto; grid-template-columns: repeat(4, auto); grid-template-rows: repeat(6, 1fr); grid-column-gap: 0px; grid-row-gap: 0px; color: white;">
                <div class="col settings-label">
                   Click-drag to:
                </div>
                <div class="col">
                  
                   <div>
                      <label>
                         <input name="click-drag" type="radio" class="with-gap setting" data-setting="click-drag" value="move" checked />
                         <span class="reduced-padding">Move</span>
                      </label>
                      <label>
                         <input name="click-drag" type="radio" class="with-gap setting" data-setting="click-drag" value="pan" />
                         <span class="reduced-padding">Pan</span>
                      </label>
                   </div>
                </div>
                <div class="col">
                   <div>
                      <span class="switch">
                         <label>
                            <input type="checkbox" class="setting" data-setting="click-drag-invert" />
                            <span class="lever"></span>
                            Invert
                         </label>
                      </span>
                   </div>
                </div>
                <div class="col">
                   <span class="slider">
                      <label class="setting-label">
                         Sensitivity
                         <p class="range-field">
                            <input type="range" min="0" max="5" step="0.1" value="1" class="setting" data-setting="click-drag-sensitivity" />
                         </p>
                      </label>
                   </span>
                </div>
            
                <div class="col settings-label">
                   Middle-click-drag to:
