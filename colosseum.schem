  </div>

  <!-- ── Info col ─────────────────────────────────────────────────────── -->
  <div class="vp-info-col">

    <!-- Breadcrumb (cliccabile + schema BreadcrumbList) -->
        <nav class="vp-breadcrumb" aria-label="Breadcrumb">
