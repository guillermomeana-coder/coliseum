                        <svg class="patreon-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:0.95em;height:0.95em;flex:0 0 auto;vertical-align:-0.12em;"><rect x="1.6" y="2" width="4.2" height="20"/><circle cx="15.7" cy="9.6" r="7.6"/></svg>                    </a>
