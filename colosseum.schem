                    <a href="/login" title="Messages">
                        <i class="fas fa-envelope"></i> Chats
                    </a>
                    <div class="nav-more">
                        <a href="#" class="nav-more-toggle" onclick="return false;" title="More">
                            <i class="fas fa-ellipsis-h"></i> More
                        </a>
                        <div class="nav-more-menu">
                            <a href="/contests"><i class="fas fa-trophy"></i> Contests</a>
                            <a href="/groups"><i class="fas fa-users"></i> Groups</a>
                        </div>
                    </div>
                    <a href="/login" title="Profile">
                        <i class="fas fa-user"></i>
                    </a>
                            </nav>
        </div>
    </div>

    <!-- ══════════════════════════════════════════
         SITE INFO MODAL
    ══════════════════════════════════════════ -->
    <div id="site-info-modal" class="sim-overlay" onclick="if(event.target===this)this.classList.remove('open')">
        <div class="sim-panel">

            <!-- Close -->
            <button class="sim-close" onclick="document.getElementById('site-info-modal').classList.remove('open')" title="Close">
                <i class="fas fa-times"></i>
            </button>

            <!-- ── HERO ── -->
            <div class="sim-hero">
                <div class="sim-hero-label">minecraftschem.com</div>
                <h1 class="sim-hero-title">The Future of<br>Minecraft Build Sharing</h1>
                <p class="sim-hero-sub">The most transparent and creator-friendly platform for Minecraft builds, schematics, and maps.<br>No hidden rules. No senseless limits. Just freedom.</p>
                <a href="https://discord.gg/zGB2YQuX3Y" target="_blank" rel="noopener" class="sim-discord-btn">
                    <i class="fab fa-discord"></i> Follow development on Discord
                </a>
            </div>

            <!-- ── STATS ── -->
            <div class="sim-stats">
                <div class="sim-stat"><span class="sim-stat-num">2000+</span><span class="sim-stat-label">Builds Created</span></div>
                <div class="sim-stat"><span class="sim-stat-num">22K+</span><span class="sim-stat-label">Community Members</span></div>
                <div class="sim-stat"><span class="sim-stat-num">3000</span><span class="sim-stat-label">Builds Target 2026</span></div>
                <div class="sim-stat"><span class="sim-stat-num">100%</span><span class="sim-stat-label">Creator First</span></div>
            </div>

            <!-- ── WHY ── -->
            <div class="sim-section">
                <h2 class="sim-section-title">Why MinecraftSchem — Built differently. For creators.</h2>
                <div class="sim-why-grid">
                    <div class="sim-why-card"><span class="sim-why-icon"><i class="fa-solid fa-lock-open"></i></span><strong>No Hidden Rules</strong><p>Every policy is public, readable, and written in plain language. No surprises, no silent changes, no arbitrary removals.</p></div>
                    <div class="sim-why-card"><span class="sim-why-icon"><i class="fa-solid fa-bolt"></i></span><strong>Instant Downloads</strong><p>No unnecessary friction, no forced extra accounts. Creators choose how to share — direct downloads or external links.</p></div>
                    <div class="sim-why-card"><span class="sim-why-icon"><i class="fa-solid fa-earth-europe"></i></span><strong>Open Platform</strong><p>We're evaluating making the entire codebase open source. Public APIs, shared data, and the freedom to build on top of it.</p></div>
                    <div class="sim-why-card"><span class="sim-why-icon"><i class="fa-solid fa-helmet-safety"></i></span><strong>Every Format</strong><p>Java schematics, Bedrock .mcstructure, maps, resource packs, and future support for Hytale prefabs. All in one place.</p></div>
                    <div class="sim-why-card"><span class="sim-why-icon"><i class="fa-solid fa-masks-theater"></i></span><strong>Massive Library</strong><p>Over 2,000 builds spanning medieval, modern, Japanese, sci-fi, fantasy, statues, maps, and hundreds of character builds.</p></div>
                    <div class="sim-why-card"><span class="sim-why-icon"><i class="fa-solid fa-comment"></i></span><strong>Real Community</strong><p>Direct access to creators, community feedback that shapes the platform, and a Discord where every voice matters.</p></div>
                </div>
            </div>

            <!-- ── MISSION ── -->
            <div class="sim-mission">
                <p>"Our mission is to build the most transparent and creator-friendly platform out there. No shady restrictions. No silence. No confusing rules. Just freedom, clarity, and open communication — the way every content-sharing site should be."</p>
                <div class="sim-values">
                    <span>Transparency</span><span>Freedom</span><span>Respect</span><span>Community</span><span>Open Source</span><span>Creator First</span>
                </div>
            </div>

            <!-- ── FEATURES GRID ── -->
            <div class="sim-section">
                <h2 class="sim-section-title">Everything you need — A full platform for Minecraft creators</h2>
                <div class="sim-feat-grid">
                    <div class="sim-feat-col">
                        <div class="sim-feat-head"><i class="fas fa-cube"></i> Posts</div>
                        <ul>
                            <li>Builds, Skins, Servers, Resource Packs</li>
                            <li>Gallery viewer with fullscreen &amp; scroll</li>
                            <li>3D schematic viewer in browser</li>
                            <li>Schedule, draft &amp; publish posts</li>
                            <li>Advanced filters &amp; sort presets</li>
                            <li>Share as branded image card</li>
                            <li>Bulk edit &amp; bulk delete</li>
                        </ul>
                    </div>
                    <div class="sim-feat-col">
                        <div class="sim-feat-head"><i class="fas fa-user"></i> Profile</div>
                        <ul>
                            <li>Custom banner, avatar &amp; slogan</li>
                            <li>Social links &amp; pronouns</li>
                            <li>9 resizable content boxes</li>
                            <li>Full stats and analytics panel</li>
                            <li>Wall posts &amp; comments</li>
                            <li>Subscriptions &amp; subscribers</li>
                            <li>YouTube integration</li>
                        </ul>
                    </div>
                    <div class="sim-feat-col">
                        <div class="sim-feat-head"><i class="fas fa-users"></i> Groups</div>
                        <ul>
                            <li>Create groups with logo &amp; banner</li>
                            <li>Follow or request membership</li>
                            <li>7 drag-and-resize boxes</li>
                            <li>Guest book, shared posts &amp; lists</li>
                            <li>Rules, FAQ &amp; useful links</li>
                        </ul>
                        <div class="sim-feat-head" style="margin-top:14px"><i class="fas fa-star"></i> XP &amp; Ranks</div>
                        <ul>
                            <li>100 levels with XP progression</li>
                            <li>11 ranks (Beginner → Celestial)</li>
                            <li>90 unlockable traits</li>
                            <li>Earn XP from likes, views, follows</li>
                        </ul>
                    </div>
                    <div class="sim-feat-col">
                        <div class="sim-feat-head"><i class="fas fa-heart"></i> Social</div>
                        <ul>
                            <li>Like, favorite &amp; comment on posts</li>
                            <li>Personal feed from creators you follow</li>
                            <li>Stories to share with friends</li>
                            <li>Direct messaging with folders</li>
                            <li>Ticket &amp; report system</li>
                        </ul>
                        <div class="sim-feat-head" style="margin-top:14px"><i class="fas fa-globe"></i> Platform</div>
                        <ul>
                            <li>Dark &amp; light theme</li>
                            <li>Global search (posts, lists, users)</li>
                            <li>Login with Google</li>
                            <li>Fully responsive layout</li>
                            <li>Moderation &amp; safety tools</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- ── BETA NOTICE ── -->
            <div class="sim-beta">
                <div class="sim-beta-badge"><i class="fa-solid fa-flask"></i> PUBLIC BETA</div>
                <p>The site is <strong>open to the public and in beta</strong> — you can use it freely right now. Found a bug? Your reports are extremely valuable.</p>
                <a href="/tickets?type=bug_report" class="sim-report-btn">
                    <i class="fas fa-bug"></i> Report a Bug
                </a>
            </div>

            <!-- ── OPEN SOURCE ── -->
            <div class="sim-section sim-opensource">
                <h2 class="sim-section-title"><i class="fab fa-github"></i> Open Source — Coming after Beta</h2>
                <p>After the beta period, the <strong>entire source code</strong> will be released publicly so that anyone can propose changes or create their own version of the site. Those who do so will also be given the opportunity to start with an initial pool of around <strong>2,000 posts</strong> — so they're visible to the entire Minecraft community right away, without the "small site" effect caused by a young platform.</p>
            </div>

            <!-- ── FOOTER LINKS ── -->
            <div class="sim-footer-links">
                <a href="https://discord.gg/zGB2YQuX3Y" target="_blank" rel="noopener" class="sim-footer-btn sim-footer-discord">
                    <i class="fab fa-discord"></i> Discord
                </a>
                <a href="/changelog.txt" download="MinecraftSchem_Changelog.txt" class="sim-footer-btn sim-footer-changelog">
                    <i class="fas fa-download"></i> Download Full Changelog
                </a>
                <a href="https://www.patreon.com/LeonisTeam" target="_blank" rel="noopener" class="sim-footer-btn sim-footer-patreon"
                   onclick="if (window.bTrack) bTrack('powered','click');">
                    Powered by LeonisTeam <svg class="patreon-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:0.95em;height:0.95em;flex:0 0 auto;vertical-align:-0.12em;"><rect x="1.6" y="2" width="4.2" height="20"/><circle cx="15.7" cy="9.6" r="7.6"/></svg>                </a>
            </div>

        </div>
    </div>

    <style>
    /* ── Info button ────────────────────────────────────── */
    .info-btn {
        background: none;
        border: none;
        color: white;
        font-size: 1rem;
        cursor: pointer;
        padding: 0;
        margin-left: 12px;
        line-height: 1;
        opacity: 0.85;
        transition: opacity 0.2s;
    }
    .info-btn:hover { opacity: 1; }

    /* ── Modal overlay ──────────────────────────────────── */
    .sim-overlay {
        display: none;
        position: fixed; inset: 0;
        background: rgba(0,0,0,0.65);
        backdrop-filter: blur(4px);
        z-index: 9999;
        overflow-y: auto;
        padding: 30px 16px 50px;
    }
    .sim-overlay.open { display: block; }

    .sim-panel {
        position: relative;
        max-width: 900px;
        margin: 0 auto;
        background: var(--card-bg);
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
    }

    .sim-close {
        position: absolute; top: 16px; right: 18px; z-index: 2;
        background: rgba(0,0,0,0.35);
        border: 1px solid rgba(255,255,255,0.12);
        color: #fff;
        width: 34px; height: 34px;
        border-radius: 50%;
        cursor: pointer; font-size: 0.9rem;
        display: flex; align-items: center; justify-content: center;
        transition: background 0.2s;
    }
    .sim-close:hover { background: rgba(255,255,255,0.15); }

    /* ── Hero ───────────────────────────────────────────── */
    .sim-hero {
        background: linear-gradient(135deg, #0e1a14 0%, #0d2520 50%, #0a1a2e 100%);
        padding: 52px 44px 44px;
        text-align: center;
        border-bottom: 1px solid var(--border);
    }
    .sim-hero-label {
        font-size: 0.75rem; letter-spacing: 3px; text-transform: uppercase;
        color: var(--teal); margin-bottom: 16px; font-weight: 700; background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .sim-hero-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(2.2rem, 6vw, 3.8rem);
        line-height: 1.05;
        color: #fff;
        margin: 0 0 18px;
        letter-spacing: 1px;
    }
    .sim-hero-sub {
        color: rgba(255,255,255,0.65);
        font-size: 1rem; line-height: 1.7;
        max-width: 580px; margin: 0 auto 26px;
    }
    .sim-discord-btn {
        display: inline-flex; align-items: center; gap: 8px;
        background: #5865F2; color: #fff;
        padding: 10px 22px; border-radius: 8px;
        text-decoration: none; font-weight: 600; font-size: 0.92rem;
        transition: box-shadow 0.2s, transform 0.15s;
    }
    .sim-discord-btn:hover { box-shadow: 0 0 18px rgba(88,101,242,0.55); transform: translateY(-1px); }

    /* ── Stats ──────────────────────────────────────────── */
    .sim-stats {
        display: grid; grid-template-columns: repeat(4,1fr);
        border-bottom: 1px solid var(--border);
    }
    .sim-stat {
        padding: 22px 12px; text-align: center;
        border-right: 1px solid var(--border);
    }
    .sim-stat:last-child { border-right: none; }
    .sim-stat-num {
        display: block;
        font-family: 'Bebas Neue', sans-serif; font-size: 2.1rem;
        color: var(--teal); line-height: 1; background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .sim-stat-label {
        display: block; font-size: 0.78rem; color: var(--text-muted);
        margin-top: 4px; text-transform: uppercase; letter-spacing: 0.8px;
    }

    /* ── Sections ───────────────────────────────────────── */
    .sim-section { padding: 36px 44px; border-bottom: 1px solid var(--border); }
    .sim-section-title {
        font-family: 'Bebas Neue', sans-serif;
        font-size: 1.35rem; letter-spacing: 1px;
        color: var(--text-strong); margin: 0 0 22px;
    }

    /* ── Why grid ───────────────────────────────────────── */
    .sim-why-grid {
        display: grid; grid-template-columns: repeat(3,1fr); gap: 14px;
    }
    .sim-why-card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 10px; padding: 16px 18px;
        transition: border-color 0.2s;
    }
    .sim-why-card:hover { border-color: var(--teal); }
    .sim-why-icon { font-size: 1.4rem; display: block; margin-bottom: 8px; }
    .sim-why-card strong { display: block; color: var(--text-strong); font-size: 0.95rem; margin-bottom: 6px; }
    .sim-why-card p { color: var(--text-muted); font-size: 0.84rem; line-height: 1.6; margin: 0; }

    /* ── Mission ────────────────────────────────────────── */
    .sim-mission {
        padding: 32px 44px;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
        text-align: center;
    }
    .sim-mission p {
        color: var(--text-muted); font-size: 0.95rem; line-height: 1.75;
        font-style: italic; max-width: 680px; margin: 0 auto 20px;
    }
    .sim-values {
        display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;
    }
    .sim-values span {
        background: var(--teal-dim); color: var(--teal);
        border: 1px solid var(--teal-border);
        padding: 4px 14px; border-radius: 20px;
        font-size: 0.82rem; font-weight: 600;
    }

    /* ── Features grid ──────────────────────────────────── */
    .sim-feat-grid {
        display: grid; grid-template-columns: repeat(4,1fr); gap: 20px;
    }
    .sim-feat-col { font-size: 0.84rem; }
    .sim-feat-head {
        display: flex; align-items: center; gap: 7px;
        font-weight: 700; color: var(--teal); margin-bottom: 10px;
        font-size: 0.88rem; text-transform: uppercase; letter-spacing: 0.6px; background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .sim-feat-col ul {
        list-style: none; padding: 0; margin: 0;
        display: flex; flex-direction: column; gap: 5px;
    }
    .sim-feat-col li {
        color: var(--text-muted); padding-left: 12px; position: relative;
        line-height: 1.45;
    }
    .sim-feat-col li::before {
        content: '›'; position: absolute; left: 0;
        color: var(--teal); font-weight: 700;
    }

    /* ── Beta notice ────────────────────────────────────── */
    .sim-beta {
        padding: 28px 44px;
        border-bottom: 1px solid var(--border);
        text-align: center;
        background: rgba(50,236,195,0.04);
    }
    .sim-beta-badge {
        display: inline-block;
        background: rgba(50,236,195,0.15); color: var(--teal);
        border: 1px solid var(--teal-border);
        padding: 4px 14px; border-radius: 20px;
        font-size: 0.78rem; font-weight: 700; letter-spacing: 1.5px;
        margin-bottom: 12px;
    }
    .sim-beta p {
        color: var(--text-muted); font-size: 0.93rem; line-height: 1.65;
        max-width: 560px; margin: 0 auto 18px;
    }
    .sim-report-btn {
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(231,76,60,0.12); color: #e74c3c;
        border: 1px solid rgba(231,76,60,0.35);
        padding: 9px 20px; border-radius: 8px;
        text-decoration: none; font-weight: 600; font-size: 0.88rem;
        transition: background 0.2s;
    }
    .sim-report-btn:hover { background: rgba(231,76,60,0.22); }

    /* ── Open source ────────────────────────────────────── */
    .sim-opensource {
        background: var(--surface);
    }
    .sim-opensource .sim-section-title { color: var(--teal); background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .sim-opensource p {
        color: var(--text-muted); font-size: 0.92rem; line-height: 1.75;
        margin: 0;
    }
    .sim-opensource strong { color: var(--text-strong); }

    /* ── Footer links ───────────────────────────────────── */
    .sim-footer-links {
        padding: 26px 44px;
        display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
        background: var(--bg);
        border-top: 1px solid var(--border);
    }
    .sim-footer-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 10px 20px; border-radius: 8px;
        text-decoration: none; font-weight: 600; font-size: 0.88rem;
        transition: box-shadow 0.2s, transform 0.15s;
    }
    .sim-footer-btn:hover { transform: translateY(-1px); }
    .sim-footer-discord  { background: #5865F2; color: #fff; }
    .sim-footer-discord:hover { box-shadow: 0 0 16px rgba(88,101,242,0.5); }
    .sim-footer-changelog { background: var(--teal-grad, var(--teal)); color: var(--btn-text); }
    .sim-footer-changelog:hover { box-shadow: 0 0 16px rgba(50,236,195,0.45); }
    .sim-footer-patreon  { background: #0d0d0d; color: #fff; border: 1px solid rgba(255,255,255,0.18); }
    .sim-footer-patreon:hover { box-shadow: 0 0 16px rgba(255,255,255,0.22); border-color: rgba(255,255,255,0.4); }

    /* ── Responsive ─────────────────────────────────────── */
    @media (max-width: 700px) {
        .sim-hero { padding: 40px 22px 32px; }
        .sim-section { padding: 28px 22px; }
        .sim-mission { padding: 26px 22px; }
        .sim-beta { padding: 24px 22px; }
        .sim-footer-links { padding: 22px 16px; }
        .sim-stats { grid-template-columns: repeat(2,1fr); }
        .sim-why-grid { grid-template-columns: 1fr 1fr; }
        .sim-feat-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 480px) {
        .sim-why-grid { grid-template-columns: 1fr; }
        .sim-feat-grid { grid-template-columns: 1fr; }
    }
    </style>
    <script>
    // Close modal on Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') document.getElementById('site-info-modal').classList.remove('open');
    });
    </script>

    <!-- Theme toggle script -->
    <script>
        (function () {
            var toggle = document.getElementById('themeToggle');
            var icon = document.getElementById('themeIcon');
            function applyTheme(theme) {
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
                if (icon) icon.className = theme === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
            }
            var current = document.documentElement.getAttribute('data-theme') || 'dark';
            if (icon) icon.className = current === 'dark' ? 'fas fa-moon' : 'fas fa-sun';
            if (toggle) toggle.addEventListener('click', function () {
                var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                applyTheme(next);
            });
        })();
    </script>
<style>

    /* Forza sfondo scuro su tutta la pagina (importante per tema scuro) */
    html, body, .profile-boxes, .grid-stack {
        background-color: var(--bg) !important;
        min-height: 100vh;
    }
/* ── view_post.php specific styles (themed) ──────────────────── */
.post-detail-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 10px;
    position: relative;
    z-index: 1;
}
.gallery-container { margin-bottom: 30px; text-align: center; }
.image-wrapper {
    position: relative;
    display: inline-block; /* shrinks to fit the image */
}
.main-image {
    display: block;
    max-height: 550px;
    object-fit: cover;
    border-radius: 10px;
    cursor: zoom-in;
}
.fullscreen-btn {
    position: absolute; top: 20px; right: 20px;
    background: rgba(0,0,0,0.7); color: white; border: none;
    border-radius: 50%; width: 50px; height: 50px;
    cursor: pointer; display: flex; align-items: center;
    justify-content: center; font-size: 1.5rem; z-index: 10;
    transition: background 0.2s;
}
.fullscreen-btn:hover { background: var(--teal-grad, var(--teal)); }
.thumbnails { display: flex; gap: 10px; margin-top: 10px; justify-content: center; }
.thumbnail {
    width: 100px; height: 75px; object-fit: cover;
    cursor: pointer; border-radius: 6px; opacity: 0.7;
    transition: opacity 0.3s, transform 0.3s;
    border: 2px solid transparent;
}
.thumbnail.active, .thumbnail:hover {
    opacity: 1; transform: scale(1.05);
    border-color: var(--teal);
}
.post-header {
    display: flex; justify-content: space-between;
    align-items: flex-start; margin-bottom: 30px;
    padding-bottom: 20px; border-bottom: 1px solid var(--border);
}
.post-info { flex: 1; }
.post-actions-sidebar {
    display: flex; flex-direction: column; gap: 15px;
    align-items: center; padding: 20px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 10px; min-width: 200px;
}
.action-btn {
    background: none; border: none; cursor: pointer;
    font-size: 1.2rem; color: var(--text-muted);
    transition: color 0.3s;
}
.action-btn:hover { color: var(--teal); }
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 15px; margin: 20px 0;
}
.stat-box {
    background: var(--surface); border: 1px solid var(--border);
    padding: 15px; border-radius: 8px; text-align: center;
    color: var(--text);
}
.stat-box strong { color: var(--text-strong); }
.creator-profile {
    display: flex; align-items: center; gap: 20px;
    padding: 20px;
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 10px; margin: 20px 0;
    box-shadow: var(--shadow-sm);
}
.social-links { display: flex; gap: 10px; margin-top: 10px; }
.social-links a {
    color: var(--text-muted); font-size: 1.2rem;
    transition: color 0.3s;
}
.social-links a:hover { color: var(--teal); background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.comments-section {
    margin-top: 40px;
    background: var(--card-bg); border: 1px solid var(--card-border);
    border-radius: 10px; padding: 24px;
}
.comment {
    border-bottom: 1px solid var(--border);
    padding: 15px 0;
    color: var(--text);
}
.comment:last-child { border-bottom: none; }
/* Prev/Next navigation */
.post-prevnext {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 40px 0 10px;
}
.post-prevnext a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
    max-width: 45%;
    transition: background 0.2s, border-color 0.2s;
    overflow: hidden;
}
.post-prevnext a:hover { background: var(--surface-2); border-color: var(--teal); color: var(--teal); }
.post-prevnext .pn-label { font-size: 0.75rem; color: var(--text-muted); display: block; }
.post-prevnext .pn-title { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
.post-prevnext .pn-spacer { flex: 1; }
/* Back to top */
#back-to-top {
    position: fixed;
    bottom: 30px;
    right: 30px;
    width: 63px;
    height: 63px;
    background: var(--teal-grad, var(--teal));
    color: #000;
    border: none;
    border-radius: 50%;
    font-size: 1.8rem;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 999;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3);
    transition: opacity 0.2s;
}
#back-to-top:hover { opacity: 0.85; }
.more-posts { margin-top: 40px; }
.more-posts .view-more-btn {
    display: block; margin: 15px auto 0;
    padding: 10px 28px;
    background: var(--card-bg);
    color: var(--teal);
    border: 1px solid var(--border);
    border-radius: 6px; text-align: center;
    cursor: pointer; font-weight: 600;
    font-size: 0.88rem; font-family: 'Outfit', sans-serif;
    transition: background 0.2s;
    width: fit-content;
    text-decoration: none;
}
.more-posts .view-more-btn:hover { background: var(--surface-2); color: var(--teal); }
.more-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px; margin-top: 20px;
}
/* Draft indicator */
.draft-notice {
    background: rgba(252,218,58,0.1);
    border: 1px solid rgba(252,218,58,0.4);
    color: var(--yellow);
    padding: 14px 18px; border-radius: 8px;
    margin-bottom: 20px; text-align: center;
    font-weight: 600;
}
/* Section panels */
.post-description, .post-details, .post-progress, .post-tags-section {
    background: var(--card-bg); border: 1px solid var(--card-border);
    padding: 24px; border-radius: 10px; margin: 20px 0;
    color: var(--text);
}
.post-description h3, .post-details h4, .post-progress h3, .post-tags-section h3 {
    color: var(--text-strong); margin-bottom: 14px;
    font-family: "Bebas Neue", sans-serif; letter-spacing: 1.5px; font-size: 1.3rem;
}
/* Tag pills */
.tag-pill {
    background: var(--teal-dim); border: 1px solid var(--teal-border);
    color: var(--teal); padding: 5px 12px;
    border-radius: 20px; font-size: 0.88rem;
    text-decoration: none; display: inline-block;
    transition: background 0.15s, border-color 0.15s;
}
.tag-pill:hover {
    background: rgba(50,236,195,0.18); border-color: var(--teal);
}
/* Download section */
.download-section { margin: 30px 0; text-align: center; }
.download-section h3 {
    font-family: "Bebas Neue", sans-serif; letter-spacing: 1.5px;
    font-size: 1.4rem; color: var(--text-strong); margin-bottom: 14px;
}
#downloadMenu {
    background: var(--dropdown-bg) !important;
    border: 1px solid var(--border) !important;
    border-radius: 8px !important;
}
#downloadMenu a {
    color: var(--text) !important;
    border-bottom: 1px solid var(--border) !important;
    transition: background 0.2s;
}
#downloadMenu a:hover { background: var(--teal-dim) !important; color: var(--teal) !important; }
/* Share to group inline widget */
.share-to-group-container {
    background: var(--surface) !important;
    border: 1px solid var(--border) !important;
    border-radius: 8px !important;
    padding: 10px !important;
    margin-top: 15px !important;
}
.share-to-group-container select {
    background: var(--input-bg) !important;
    border: 1px solid var(--input-border) !important;
    color: var(--text) !important;
    border-radius: 6px !important;
}
/* List modal */
#listModal > div {
    background: var(--card-bg) !important;
    border: 1px solid var(--border) !important;
    border-radius: 12px !important;
}
/* Coords popup */
#coordsPopup > div {
    background: var(--card-bg) !important;
    border: 1px solid var(--border) !important;
    border-radius: 12px !important;
    color: var(--text) !important;
}
#coordsPopup input {
    background: var(--input-bg) !important;
    border: 1px solid var(--input-border) !important;
    color: var(--text) !important;
    border-radius: 6px !important;
    padding: 6px 10px !important;
}
/* Other posts cards */
.more-posts .post-card {
    background: var(--card-bg) !important;
    border: 1px solid var(--card-border) !important;
    border-radius: 8px !important;
    box-shadow: var(--shadow-sm) !important;
}
.more-posts .post-card a { color: var(--text-strong) !important; }
.more-posts .post-card a:hover { color: var(--teal) !important; background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
/* Spin animation for 3D viewer loader */
@keyframes spin {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}


.btn-secondary:hover {
color: var(--text);
}

.btn-primary:hover {
color: var(--text) !important;
}
.btn:hover {
color: var(--text) !important;
}

.btn-info:hover {
color: var(--text);
}
</style>

<style>
/* ── Product layout (Shopify-style 2-col) ─────────────────────────────── */
.vp-product-layout {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 36px;
    align-items: start;
    margin-bottom: 36px;
}
.vp-gallery-col { position: static; }
.vp-main-img-wrap {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    line-height: 0;
}
.vp-main-img {
    display: block;
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    cursor: zoom-in;
    line-height: 1;
}
.vp-edit-btn {
    position: absolute; top: 14px; left: 14px; z-index: 10;
    background: rgba(0,0,0,0.55); color: #fff;
    padding: 7px 13px; border-radius: 8px;
    text-decoration: none; font-size: 0.87rem;
    backdrop-filter: blur(4px); transition: background 0.2s;
}
.vp-edit-btn:hover { background: var(--teal-grad, var(--teal)); filter: brightness(1.08); color: #000; }
.vp-fullscreen-btn {
    position: absolute; top: 14px; right: 14px; z-index: 10;
    background: rgba(0,0,0,0.55); color: #fff; border: none;
    border-radius: 50%; width: 42px; height: 42px;
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; transition: background 0.2s; backdrop-filter: blur(4px);
}
.vp-fullscreen-btn:hover { background: var(--teal-grad, var(--teal)); color: #000; }
.vp-thumbnails {
    display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;
}
.vp-thumb {
    width: 76px; height: 56px; object-fit: cover;
    cursor: pointer; border-radius: 6px; opacity: 0.6;
    transition: opacity 0.2s, border-color 0.2s;
    border: 2px solid transparent; flex-shrink: 0;
}
.vp-thumb.active, .vp-thumb:hover { opacity: 1; border-color: var(--teal); }

/* Info column */
.vp-info-col { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 76px; }
.vp-breadcrumb {
    font-size: 0.8rem; color: var(--text-muted);
    display: flex; align-items: center; gap: 6px;
}
.vp-post-type-badge {
    font-weight: 700; color: var(--teal);
    text-transform: uppercase; letter-spacing: 0.6px; font-size: 0.78rem;
    background: var(--teal-dim); border: 1px solid var(--teal-border);
    padding: 2px 8px; border-radius: 4px;
}
.vp-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.3rem; letter-spacing: 2px;
    color: var(--text-strong); line-height: 1.1; margin: 0;
}
.vp-creator-row {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none; color: var(--text);
    padding: 10px 14px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; transition: border-color 0.2s;
}
.vp-creator-row:hover { border-color: rgba(50,236,195,0.4); }
.vp-creator-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    object-fit: cover; border: 2px solid var(--border); flex-shrink: 0;
}
.vp-creator-name { font-weight: 700; font-size: 0.92rem; color: var(--text-strong); display: block; }
.vp-creator-date { font-size: 0.76rem; color: var(--text-muted); display: block; margin-top: 1px; }

/* Compact stats */
.vp-stats-inline {
    display: flex; flex-wrap: wrap; gap: 6px 10px;
    font-size: 0.79rem; color: var(--text-muted);
    padding: 10px 10px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
}
.vp-stats-inline strong { color: var(--text-strong); }

/* Download CTA */
.vp-download-cta { display: flex; flex-direction: column; gap: 8px; }
.vp-dl-primary { position: relative; width: 100%; }
.vp-btn-download-main {
    width: 100%; background: var(--teal-grad, var(--teal)); color: #000;
    border: 2px solid var(--teal); border-radius: 10px;
    padding: 15px 20px; font-size: 1.05rem; font-weight: 800;
    font-family: 'Outfit', sans-serif; letter-spacing: 0.5px;
    cursor: pointer; display: flex; align-items: center;
    justify-content: center; gap: 10px;
    box-shadow: 0 0 18px rgba(50,236,195,0.25);
    transition: background 0.2s, box-shadow 0.2s, transform 0.15s;
}
.vp-btn-download-main:hover {
    background: var(--teal-grad, var(--teal)); filter: brightness(1.08); box-shadow: 0 0 28px rgba(50,236,195,0.5);
    transform: translateY(-1px);
}
a.vp-btn-download-main, a.vp-btn-download-main:hover, a.vp-btn-download-main:visited { color: #000; text-decoration: none; -webkit-text-fill-color: #000; }
.vp-btn-download-main .vp-chevron { margin-left: auto; font-size: 0.82rem; }
.vp-dl-primary #downloadMenu { min-width: 100%; left: 0; top: calc(100% + 4px); }
.vp-btn-view3d, .vp-btn-alt-dl {
    width: 100%; background: var(--teal-dim); color: var(--teal);
    border: 1px solid var(--teal-border); border-radius: 10px;
    padding: 12px 20px; font-size: 0.92rem; font-weight: 700;
    font-family: 'Outfit', sans-serif;
    cursor: pointer; display: flex; align-items: center;
    justify-content: center; gap: 10px; text-decoration: none;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
}
.vp-btn-view3d:hover, .vp-btn-alt-dl:hover {
    border-color: var(--teal); background: rgba(50,236,195,0.15);
    box-shadow: 0 0 14px rgba(50,236,195,0.2); color: var(--teal);
}

/* Social action row */
.vp-actions-row { display: flex; gap: 6px; flex-wrap: wrap; }
.vp-action {
    flex: 1; min-width: 40px;
    display: flex; align-items: center; justify-content: center; gap: 5px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
    padding: 9px 6px; color: var(--text-muted); font-size: 0.85rem;
    cursor: pointer; transition: color 0.2s, border-color 0.2s, background 0.2s;
    white-space: nowrap; font-family: 'Outfit', sans-serif;
}
.vp-action:hover { color: var(--teal); border-color: rgba(50,236,195,0.4); background: var(--surface-2); }
.vp-action.liked, .vp-action.favorited { color: var(--teal); border-color: rgba(50,236,195,0.4); }
.vp-action .count { font-size: 0.8rem; font-weight: 600; }
.vp-modified { font-size: 0.76rem; color: var(--text-muted); display: block; margin-top: 2px; }

/* ── Author slider ──────────────────────────────── */
.vp-slider-section { margin: 20px 0 8px; }
.vp-slider-header {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 10px;
}
.vp-slider-label {
    font-size: 0.88rem; text-transform: uppercase; letter-spacing: 1.2px;
    color: var(--text-muted); font-weight: 700;
}
.vp-slider-track {
    display: flex; gap: 10px;
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: thin; scrollbar-color: var(--teal-border) transparent;
    padding-bottom: 6px;
}
.vp-slider-track::-webkit-scrollbar { height: 3px; }
.vp-slider-track::-webkit-scrollbar-thumb { background: var(--teal-border); border-radius: 2px; }
.vp-slide-card {
    flex-shrink: 0; width: 215px; text-decoration: none;
    color: var(--text); scroll-snap-align: start;
}
.vp-slide-card img {
    width: 215px; height: 128px; object-fit: cover;
    border-radius: 8px; border: 1px solid var(--border); display: block;
    transition: border-color 0.2s;
}
.vp-slide-card:hover img { border-color: rgba(50,236,195,0.5); }
/* card fissa del Patreon: stessa misura di un'anteprima, spazio tutto occupato */
.vp-slide-pat-box {
    width: 215px; height: 128px; border-radius: 8px; border: 1px solid var(--border);
    background:
        radial-gradient(120% 90% at 0% 0%, rgba(50,236,195,.10), transparent 60%),
        linear-gradient(160deg, #12100f, #0d0d0d);
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 10px 11px; box-sizing: border-box; transition: border-color .2s, box-shadow .2s;
}
.vp-slide-patreon:hover .vp-slide-pat-box { border-color: rgba(50,236,195,0.5); box-shadow: 0 6px 18px rgba(50,236,195,.18); }
.vp-slide-pat-head { display: flex; align-items: center; gap: 9px; }
.vp-slide-pat-mark {
    flex: 0 0 34px; height: 34px; border-radius: 9px; background: #000;
    display: flex; align-items: center; justify-content: center;
}
.vp-slide-pat-mark .patreon-mark { color: #fff; }
.vp-slide-pat-title {
    font-family: 'Bebas Neue', sans-serif; font-size: 1.02rem; letter-spacing: .5px;
    color: #fff; line-height: 1.02;
}
.vp-slide-pat-perks { display: flex; flex-direction: column; gap: 3px; }
.vp-slide-pat-perks span { font-size: .64rem; color: #cfd6dd; display: flex; align-items: center; gap: 5px; }
.vp-slide-pat-perks i { color: var(--teal); font-size: .56rem; }
.vp-slide-pat-cta {
    background: var(--teal-grad, var(--teal)); color: #04120e;
    border-radius: 7px; padding: 5px 10px; font-size: .72rem; font-weight: 800;
    text-align: center;
}
/* solo questo titolo e' centrato e colorato: gli altri restano come sono.
   Doppia classe perche' .vp-slide-title e' definita piu' sotto e vincerebbe. */
.vp-slide-title.vp-slide-title-pat {
    text-align: center; font-weight: 800; letter-spacing: .5px; font-size: .78rem;
    color: var(--teal);
    background-image: var(--teal-grad, none);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.vp-slide-title {
    display: block; font-size: 0.75rem; color: var(--text-strong);
    margin-top: 5px; white-space: nowrap; overflow: hidden;
    text-overflow: ellipsis; max-width: 215px; font-weight: 600;
}
.vp-slide-end-card {
    flex-shrink: 0; width: 190px; scroll-snap-align: start;
    display: flex; flex-direction: column; justify-content: center;
    align-items: stretch; gap: 6px; padding: 12px 12px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; height: 128px; box-sizing: border-box;
}
.vp-slide-end-btn {
    display: block; padding: 8px 10px; border-radius: 6px;
    font-size: 0.75rem; font-weight: 600; text-align: center;
    cursor: pointer; text-decoration: none; border: none;
    font-family: 'Outfit', sans-serif; line-height: 1.2;
}
.vp-slide-end-viewall {
    background: var(--teal-dim); color: var(--teal);
    border: 1px solid var(--teal-border);
}
.vp-slide-end-more {
    background: var(--teal-grad, var(--teal)); color: var(--btn-text);
}
.vp-slide-end-more:hover { opacity: 0.88; }
.vp-cta-box {
    padding: 10px 16px; border-radius: 8px;
    font-size: 0.88rem; font-weight: 600; text-align: center;
    font-family: 'Outfit', sans-serif; letter-spacing: 0.2px;
    line-height: 1.4;
}

@media (max-width: 900px) {
    .vp-product-layout { grid-template-columns: 1fr; }
    .vp-gallery-col { position: static; }
    .vp-title { font-size: 1.9rem; }
}
</style>



<div class="post-detail-container">
<!DOCTYPE html>
<html lang="en">
