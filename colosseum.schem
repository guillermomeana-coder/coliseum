<style>
.site-stats {
    background: var(--nav-bg);
    color: var(--text);
    padding: 30px 0;
    border-top: 3px solid var(--teal);
}

.site-stats h3 {
    text-align: center;
    margin-bottom: 25px;
    font-size: 1.5rem;
    color: var(--text-muted);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    max-width: 1000px;
    margin: 0 auto;
}

.stat-item {
    text-align: center;
    padding: 20px;
    background: var(--nav-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: transform 0.3s, background 0.3s;
}

.stat-item:hover {
    transform: translateY(-5px);
    background: var(--nav-bg);
}

.stat-number {
    font-size: 2.5rem;
    font-weight: bold;
    margin-bottom: 5px;
    color: var(--teal); background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

.stat-label {
    font-size: 0.9rem;
    color: var(--text-muted);
}
.stat-update {
    font-size: 0.65rem;
    color: var(--text-muted);
    opacity: 0.5;
    margin-top: 4px;
}

/* contatore a rullo: ogni cifra e' una colonna 0-9 che scorre */
.odo { display: inline-flex; align-items: flex-start; overflow: hidden; }
/* clip-path oltre a overflow: con la card che si alza in hover il solo overflow
   lasciava spuntare un pezzo della cifra sopra */
.odc { display: inline-block; overflow: hidden; clip-path: inset(0); height: 1em; line-height: 1em;
       width: .62em; backface-visibility: hidden; }
.stat-item { overflow: hidden; }
.odr { display: block; transition: transform 1.5s cubic-bezier(.18,.72,.2,1); }
.odr b { display: block; height: 1em; line-height: 1em; font-weight: inherit; text-align: center; }
.ods { display: inline-block; width: .3em; height: 1em; line-height: 1em; text-align: center; }
@media (prefers-reduced-motion: reduce) { .odr { transition: none; } }

@media (max-width: 768px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }
    
    .stat-number {
        font-size: 2rem;
    }
}
</style>

<script>
/* Numeri vivi, contatore a rullo stile YouTube: ogni cifra scorre nella sua
   colonna e le unita' partono per prime, poi decine, centinaia e cosi' via.
   Le richieste partono solo con la sezione sullo schermo e la scheda davanti. */
(function () {
    const URL_ = '/api/site_stats.php';
    const box = document.querySelector('.site-stats');
    if (!box || !window.IntersectionObserver) return;
    const cells = [...box.querySelectorAll('.stat-number[data-stat]')];
    if (!cells.length) return;
    const nf = new Intl.NumberFormat('en-US');
    let timer = null, busy = false;

    const DUR = 1500, STEP = 500, HOME = 10;   // la colonna ha 0-9 tre volte: la "casa" e' la seconda

    function build(el, txt) {
        el.innerHTML = '';
        const wrap = document.createElement('span');
        wrap.className = 'odo';
        for (const ch of txt) {
            if (ch >= '0' && ch <= '9') {
                const c = document.createElement('span');
                c.className = 'odc';
                const r = document.createElement('span');
                r.className = 'odr';
                for (let k = 0; k < 30; k++) { const b = document.createElement('b'); b.textContent = k % 10; r.appendChild(b); }
                r.style.transform = 'translateY(-' + (HOME + +ch) + 'em)';
                c.dataset.v = ch;
                c.appendChild(r);
                wrap.appendChild(c);
            } else {
                const sp = document.createElement('span');
                sp.className = 'ods';
                sp.textContent = ch;
                wrap.appendChild(sp);
            }
        }
        el.appendChild(wrap);
        el.dataset.n = (txt.match(/[0-9]/g) || []).join('');
    }

    function show(el, n) {
        const txt = nf.format(n);
        const chars = [...txt].filter(c => c >= '0' && c <= '9');
        const cols = el.querySelectorAll('.odc');
        if (cols.length !== chars.length) { build(el, txt); return; }

        const was = parseInt(el.dataset.n || '0', 10);
        if (was === n) return;
        const up = n > was;                       // conta il numero intero, non la singola cifra
        el.dataset.n = chars.join('');

        chars.forEach((v, i) => {
            const c = cols[i];
            if (c.dataset.v === v) return;
            const from = HOME + (+c.dataset.v);
            // tutte le colonne girano nello stesso verso: si passa dalla copia
            // sopra o sotto quella di riposo, poi si rientra senza animazione
            let to = HOME + (+v);
            if (up && to <= from) to += 10;       // salire: si va sempre alla copia piu' avanti
            if (!up && to >= from) to -= 10;      // scendere: sempre a quella piu' indietro
            c.dataset.v = v;

            const r = c.querySelector('.odr');
            const delay = Math.min((chars.length - 1 - i) * STEP, 4000);
            r.style.transitionDelay = delay + 'ms';
            r.style.transform = 'translateY(-' + to + 'em)';
            setTimeout(() => {                    // rientro muto alla copia di riposo
                r.style.transition = 'none';
                r.style.transform = 'translateY(-' + (HOME + (+v)) + 'em)';
                void r.offsetWidth;
                r.style.transition = '';
                r.style.transitionDelay = '0ms';
            }, delay + DUR + 40);
        });
    }

    cells.forEach(el => build(el, el.textContent.trim()));

    async function tick() {
        if (busy || document.hidden) return;
        busy = true;
        try {
            const d = await (await fetch(URL_, { credentials: 'same-origin' })).json();
            cells.forEach(el => { const v = d[el.dataset.stat]; if (typeof v === 'number') show(el, v); });
        } catch (e) { /* rete ballerina: si riprova al giro dopo */ }
        busy = false;
    }

    let onScreen = false;
    function start() { if (!timer) { tick(); timer = setInterval(tick, 10000); } }
    function stop() { clearInterval(timer); timer = null; }

    new IntersectionObserver(es => {
        onScreen = es[0].isIntersecting;
        onScreen && !document.hidden ? start() : stop();
    }, { threshold: 0.1 }).observe(box);
    // tornando sulla scheda si riparte: l'observer non rispara da solo
    document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else if (onScreen) start();
    });
})();
</script>
