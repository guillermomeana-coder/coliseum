                <!-- Contenitore destro (toggle + profilo) — sempre visibile -->
                <div class="header-top-right">

                    <!-- Theme toggle — funziona per tutti tramite localStorage -->
                    <button class="theme-toggle" id="themeToggle" title="Toggle light / dark theme" aria-label="Toggle theme">
                        <i class="fas fa-moon" id="themeIcon"></i>
                    </button>

                    
                </div>
            </div>

            <!-- Search bar -->
            <div class="search-bar" style="position:relative;">
                <i class="fas fa-search"></i>
                <form action="/search.php" method="get" id="main-search-form">
                    <input type="text" name="q" id="main-search-input" placeholder="Search posts, lists, users and groups…" autocomplete="off">
                </form>
                <div id="main-search-suggestions"
                     style="display:none;position:absolute;top:100%;left:0;right:0;background:var(--card-bg);border:1px solid var(--border);border-radius:8px;z-index:99999;box-shadow:0 4px 16px rgba(0,0,0,0.3);max-height:320px;overflow-y:auto;margin-top:4px;"></div>
            </div>
        </div>
    </header>

    
    <div class="header-bottom">
