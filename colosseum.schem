        <script>
        var _sliderOffset = 10;
        var _sliderAuthorId = 8;
        var _sliderExcludeId = 1216;

        function loadMoreSlider() {
            var btn = document.getElementById('vp-slider-more-btn');
            btn.disabled = true;
            btn.textContent = 'Loading…';
            fetch('get_slider_posts.php?user_id=' + _sliderAuthorId
                + '&exclude=' + _sliderExcludeId
                + '&offset=' + _sliderOffset + '&limit=10')
            .then(function(r){ return r.json(); })
            .then(function(posts){
                var track = document.getElementById('vp-slider-track');
                var endCard = document.getElementById('vp-slider-end');
                posts.forEach(function(p){
                    var a = document.createElement('a');
                    a.href = p.url;
                    a.className = 'vp-slide-card';
                    a.innerHTML = '<img src="' + p.cover + '" alt="' + p.title.replace(/"/g,'&quot;') + '"><span class="vp-slide-title">' + p.title + '</span>';
                    track.insertBefore(a, endCard);
                });
                _sliderOffset += posts.length;
                if (posts.length < 10) {
                    btn.style.display = 'none';
                } else {
                    btn.disabled = false;
                    btn.textContent = 'View more';
                }
            })
            .catch(function(){ btn.disabled = false; btn.textContent = 'View more'; });
        }
        </script>
        

