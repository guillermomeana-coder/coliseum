    <script>

// Back to top
(function() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;
    window.addEventListener('scroll', function() {
        btn.style.display = window.scrollY > 400 ? 'flex' : 'none';
    });
    btn.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    });
})();

// JS per toggle dropdown puro CSS
function toggleDownloadDropdown() {
    const menu = document.getElementById('downloadMenu');
    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
}
// Chiudi se click fuori
document.addEventListener('click', function(e) {
    const dropdown = document.querySelector('.download-dropdown');
    if (!dropdown.contains(e.target)) {
        document.getElementById('downloadMenu').style.display = 'none';
    }
});
// Gestione conversione
function handleConversion(fmt, postId, originalExt) {
    if (originalExt === 'mcworld' && fmt !== 'mcworld') {
        document.getElementById('targetFmt').value = fmt;
        document.getElementById('coordsPopup').style.display = 'flex';
    } else {
        window.location.href = `convert.php?id=${postId}&target=${fmt}`;
    }
}

// Gestione form popup
document.getElementById('coordsForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    fetch('convert.php', {
        method: 'POST',
        body: formData
    }).then(response => response.blob())
    .then(blob => {
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `converted.${formData.get('target_fmt')}`;
        a.click();
        closeCoordsPopup();
    }).catch(() => alert('Conversion error'));
});

function closeCoordsPopup() {
    document.getElementById('coordsPopup').style.display = 'none';
}


// JS per toggle dropdown puro CSS
function toggleDownloadDropdown() {
    const menu = document.getElementById('downloadMenu');
    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
}

// Chiudi se click fuori
document.addEventListener('click', function(e) {
    const dropdown = document.querySelector('.download-dropdown');
    if (!dropdown.contains(e.target)) {
        document.getElementById('downloadMenu').style.display = 'none';
    }
});
        // Gallery
        // in galleria le versioni da 1280; gli originali servono solo a schermo intero
        const images = ["https:\/\/minecraftschem.com\/uploads\/thumbs\/w1280\/0c64e6843b5341c3a49c927c79095de16c24ab35.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/w1280\/eafa94a9676b47cf030ea385bda23097efeddbcc.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/w1280\/3f3dbe73e1d612357533f955ef94bb7cc4f60508.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/w1280\/ee7fd29e2cf1fd11ed654780056105949408dacd.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/w1280\/2cd08ad7fc5fe24548aa6d82e5fbf9e400326b4b.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/w1280\/28176c0fafc39cb5c8af70f457d2de43eacfba00.webp"];
        // schermo intero: risoluzione piena ma in WebP q92 (un sesto del peso)
        const imagesFull = ["https:\/\/minecraftschem.com\/uploads\/thumbs\/full\/0c64e6843b5341c3a49c927c79095de16c24ab35.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/full\/eafa94a9676b47cf030ea385bda23097efeddbcc.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/full\/3f3dbe73e1d612357533f955ef94bb7cc4f60508.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/full\/ee7fd29e2cf1fd11ed654780056105949408dacd.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/full\/2cd08ad7fc5fe24548aa6d82e5fbf9e400326b4b.webp","https:\/\/minecraftschem.com\/uploads\/thumbs\/full\/28176c0fafc39cb5c8af70f457d2de43eacfba00.webp"];
        let currentImageIndex = 0;
        function changeImage(index) {
            currentImageIndex = index;
            document.getElementById('mainImage').src = images[index];
            document.querySelectorAll('.thumbnail').forEach((thumb, i) => {
                thumb.classList.toggle('active', i === index);
            });
        }
        function openFullscreen() {
            const image = document.getElementById('mainImage');
            // a schermo intero si carica l'originale, non la versione ridotta
            if (imagesFull[currentImageIndex]) image.src = imagesFull[currentImageIndex];
            if (image.requestFullscreen) image.requestFullscreen();
            else if (image.mozRequestFullScreen) image.mozRequestFullScreen();
            else if (image.webkitRequestFullscreen) image.webkitRequestFullscreen();
            else if (image.msRequestFullscreen) image.msRequestFullscreen();
        }
        // Sposta listModal come figlio diretto di body (escape stacking context)
        document.addEventListener('DOMContentLoaded', function() {
            const m = document.getElementById('listModal');
            if (m) document.body.appendChild(m);
        });
        // Modal Liste
        function showListModal(postId) {
            document.getElementById('listModal').style.display = 'block';
            document.getElementById('listModal').dataset.postId = postId;
            document.body.style.overflow = 'hidden';
                    }
        function hideListModal() {
            document.getElementById('listModal').style.display = 'none';
            document.body.style.overflow = 'auto';
                    }
                // Eventi globali
        document.addEventListener('click', function(e) {
            const modal = document.getElementById('listModal');
            if (e.target === modal) hideListModal();
        });
   
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') hideListModal();
        });
        // Like/Favorite
        document.querySelectorAll('.like-btn, .favorite-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const postId = this.dataset.post;
                const action = this.classList.contains('like-btn') ? 'like' : 'favorite';
                fetch('post_actions.php', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: `post_id=${postId}&action=${action}`
                })
                .then(r => r.json())
                .then(d => {
                    if (d.success) this.querySelector('.count').textContent = d.new_count;
                });
            });
        });
        // Navigazione immagini
        document.addEventListener('keydown', function(e) {
            if (images.length <= 1) return;
            if (e.key === 'ArrowLeft') {
                changeImage((currentImageIndex - 1 + images.length) % images.length);
            } else if (e.key === 'ArrowRight') {
                changeImage((currentImageIndex + 1) % images.length);
            }
        });
        // Follow
        function toggleFollow(userId) {
                        window.location.href = 'login'; return;
                        fetch('follow_action.php', {
                method: 'POST',
                headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                body: 'following_id=' + userId
            })
            .then(r => r.json())
            .then(d => {
                if (d.success) {
                    const btn = document.getElementById('followBtn');
                    const count = document.querySelector('.follow-count');
                    if (d.action === 'followed') {
                        btn.textContent = 'Following';
                        btn.classList.remove('btn-primary');
                        btn.classList.add('btn-outline');
                    } else {
                        btn.textContent = 'Follow';
                        btn.classList.remove('btn-outline');
                        btn.classList.add('btn-primary');
                    }
                    count.textContent = d.followers_count + ' followers';
                }
            });
        }
    </script>
<script>

// Inizializza i dropdown per view_post.php
document.addEventListener('DOMContentLoaded', function() {
    // Inizializza i dropdown degli username
    if (typeof initializeUserDropdowns === 'function') {
        initializeUserDropdowns();
    }
    // Gestione follow button
    const followBtn = document.getElementById('followBtn');
    if (followBtn) {
        followBtn.addEventListener('click', function(e) {
            e.preventDefault();
            const userId = this.dataset.user;
            toggleFollowViewPost(userId, this);
        });
    }
});
// Funzione per follow/unfollow in view_post
function toggleFollowViewPost(userId, element) {
            window.location.href = 'login';
        return;
        fetch('user_actions.php', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
        },
        body: `target_user_id=${userId}&action=toggle_follow`
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            if (data.action === 'followed') {
                element.innerHTML = '<i class="fa-solid fa-check"></i> Following';
                element.classList.remove('btn-primary');
                element.classList.add('btn-outline');
                // Update follower counter
                const countElement = document.querySelector('.follow-count');
                if (countElement) {
                    countElement.textContent = data.followers_count + ' followers';
                }
            } else {
                element.innerHTML = 'Follow';
                element.classList.remove('btn-outline');
                element.classList.add('btn-primary');
                // Update follower counter
                const countElement = document.querySelector('.follow-count');
                if (countElement) {
                    countElement.textContent = data.followers_count + ' followers';
                }
            }
        } else {
            alert('Error: ' + data.error);
        }
    })
    .catch(error => {
        console.error('Follow error:', error);
        alert('Connection error');
    });
}
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestione report post (sia index che view_post)
    document.querySelectorAll('.report-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const postId = this.dataset.post;
            if (!postId) return;
            // Apri modal per report
            showReportModal(postId);
        });
    });
});
var _reportModal = null;
function closeReportModal() {
    if (_reportModal) { _reportModal.remove(); _reportModal = null; }
}
function showReportModal(postId) {
    _reportModal = document.createElement('div');
    _reportModal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:10000;display:flex;align-items:center;justify-content:center;';
    _reportModal.innerHTML = `
        <div style="background:var(--card-bg);border:1px solid var(--border);padding:30px;border-radius:12px;max-width:500px;width:90%;box-shadow:var(--shadow-lg);">
            <h3 style="margin-top:0;font-family:'Bebas Neue',sans-serif;letter-spacing:1.5px;color:var(--text-strong);">Report Post #${postId}</h3>
            <form action="create_ticket.php" method="POST" onsubmit="return sendReport(this);">
                <input type="hidden" name="type" value="report_post">
                <input type="hidden" name="target_id" value="${postId}">
                <div style="margin:15px 0;">
                    <label style="font-size:0.82em;font-weight:700;letter-spacing:0.5px;text-transform:uppercase;color:var(--text-muted);"><strong>Reason</strong></label>
                    <textarea name="description" placeholder="Describe the issue…" required style="width:100%;height:100px;padding:10px;border:1px solid var(--border);border-radius:6px;margin-top:5px;background:var(--input-bg);color:var(--text);font-family:inherit;"></textarea>
                </div>
                <div style="display:flex;gap:10px;justify-content:flex-end;">
                    <button type="submit" style="background:#e74c3c;color:white;padding:10px 20px;border:none;border-radius:6px;cursor:pointer;">Submit Report</button>
                    <button type="button" onclick="closeReportModal()" style="background:var(--surface-2);color:var(--text);border:1px solid var(--border);padding:10px 20px;border:none;border-radius:6px;cursor:pointer;">Cancel</button>
                </div>
            </form>
        </div>
    `;
    _reportModal.addEventListener('click', function(e) { if (e.target === _reportModal) closeReportModal(); });
    document.body.appendChild(_reportModal);
}
// invio senza cambiare pagina: resta sul post e compare la targhetta verde
function sendReport(form) {
    const btn = form.querySelector('button[type="submit"]');
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        credentials: 'same-origin',
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(d => {
        closeReportModal();
        if (d && d.success) mcsToast(d.message || 'Report submitted!', 'ok');
        else mcsToast((d && d.message) || 'Error sending the report', 'error');
    })
    .catch(() => { closeReportModal(); mcsToast('Error sending the report', 'error'); });
    return false;
}
</script>
