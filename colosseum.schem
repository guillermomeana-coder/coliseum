<!-- 3D Viewer: identical to https://github.com/EndingCredits/litematic-viewer -->
<script src="https://unpkg.com/deepslate@0.10.1"></script>
<script src="https://unpkg.com/gl-matrix@3.4.3/gl-matrix-min.js"></script>

<!-- Viewer source files (v=3 forces cache refresh) -->
<script src="resource/assets.js?v=3"></script>
<script src="resource/opaque.js?v=3"></script>
<script src="src/deepslate-helpers.js?v=3"></script>
<script src="src/litematic-utils.js?v=3"></script>
<script src="src/main.js?v=5"></script>
<script src="src/settings.js?v=3"></script>
<script src="src/viewer.js?v=3"></script>


<script>
// Uso in view_post.php

// Il tuo script JS aggiornato (con callback per hideLoading e funzioni open/close settings)
document.addEventListener("DOMContentLoaded", function() {
    const image = document.getElementById('atlas');
    if (image.complete) {
        loadDeepslateResources(image);
    } else {
        image.addEventListener('load', () => {
            loadDeepslateResources(image);
        });
    }
    image.addEventListener('error', (error) => {
        console.error("Error loading texture atlas:", error);
    });
});

window.open3DViewer = function(url) {
    const modal = document.getElementById('3d-viewer-modal');
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    const hb = document.querySelector('.header-bottom');
    if (hb) hb.style.display = 'none';
    const btt = document.getElementById('back-to-top');
    if (btt) btt.style.display = 'none';
    showLoading();
    
    fetch(url)
        .then(r => {
            if (!r.ok) throw new Error('File not found or server error (' + r.status + ')');
            const ct = r.headers.get('Content-Type') || '';
            if (ct.includes('text/html')) throw new Error('Server returned HTML instead of a binary file. The schematic file may be missing on the server.');
            return r.arrayBuffer();
        })
        .then(ab => {
            if (ab.byteLength === 0) throw new Error('Downloaded file is empty.');
            const file = new Blob([ab], {type: 'application/octet-stream'});
            loadAndProcessFile(file, hideLoading);
        })
        .catch(err => {
            console.error('Error loading schematic:', err);
            hideLoading();
            alert('Error loading schematic: ' + err.message);
        });
};

window.close3DViewer = function() {
    const modal = document.getElementById('3d-viewer-modal');
    modal.style.display = 'none';
    document.body.style.overflow = 'auto';
    const hb = document.querySelector('.header-bottom');
    if (hb) hb.style.display = '';
    const btt = document.getElementById('back-to-top');
    if (btt) btt.style.display = '';
    hideLoading();
    
    // Pulizia: rimuovi canvas e nascondi elementi
    const viewer = document.getElementById('viewer');
    viewer.innerHTML = '';
    document.getElementById('sliders').style.display = 'none';
    document.getElementById('materialListButton').style.display = 'none';
    document.getElementById('materialList').style.display = 'none';
    document.getElementById('build-info').style.display = 'none';
    closeSettings();
};

// Funzioni loading
function showLoading() {
    const overlay = document.getElementById('loading-overlay');
    if (overlay) overlay.style.display = 'flex';
}
function hideLoading() {
    const overlay = document.getElementById('loading-overlay');
    if (overlay) overlay.style.display = 'none';
}

// Funzioni per settings panel
function openSettings() {
  document.getElementById("settings-panel").style.width = "800px";
}
function closeSettings() {
  document.getElementById("settings-panel").style.width = "0";
}



</script>




</body>

</html>
</div>
    <style>
.side-banner {
    display: none;
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    width: clamp(210px, calc((100vw - 1280px) / 2 - 28px), 320px);
    background: linear-gradient(160deg, var(--bg2) 0%, rgba(50,236,195,0.07) 100%);
    border: 1px solid rgba(50,236,195,0.45);
    border-radius: 16px;
    padding: 22px 20px;
    box-sizing: border-box;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text);
    box-shadow: 0 0 28px rgba(50,236,195,0.18), 0 8px 32px rgba(0,0,0,0.45);
    transition: box-shadow 0.3s, border-color 0.3s;
}
.side-banner:hover {
    border-color: var(--teal);
    box-shadow: 0 0 42px rgba(50,236,195,0.35), 0 8px 32px rgba(0,0,0,0.45);
}
/* Footer must paint over the fixed banners */
footer { position: relative; z-index: 60; }
.side-banner--left  {
    left: calc((100vw - 1200px) / 4);
    transform: translate(-50%, -50%);
}
.side-banner--right {
    right: calc((100vw - 1200px) / 4);
    transform: translate(50%, -50%);
}
@media (min-width: 1680px) {
    .side-banner { display: block; }
}
/* Mobile/tablet in vista desktop (viewport 1500) + laptop stretti:
   banner fissi ai lati, larghi 145px, attaccati ai bordi (3px). */
/* .sb-narrow viene messa dal JS sul <html> quando la viewport è più stretta di
   1680px: i banner si ancorano al DOCUMENTO (sempre largo >= 1500px), così
   restano ai lati anche se il browser ignora il meta viewport. */
html.sb-narrow .side-banner {
    display: block;
    position: fixed;
    width: 145px;
    padding: 12px 10px;
    font-size: 0.8rem;
    line-height: 1.45;
    border-radius: 12px;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
}
html.sb-narrow .side-banner--left  { left: 3px;  right: auto; }
html.sb-narrow .side-banner--right { right: 3px; left: auto; }
html.sb-narrow .side-banner--promo { right: 3px; left: auto; padding: 10px 9px; }
html.sb-narrow .side-banner--promo.on-left { left: 3px; right: auto; }
.side-banner--promo.on-left { left: calc((100vw - 1200px) / 4); right: auto; transform: translateX(-50%); }
html.sb-narrow .side-banner .sb-label { font-size: 0.75rem; letter-spacing: 1.2px; margin-bottom: 7px; }
html.sb-narrow .side-banner .sb-title { font-size: 1.05rem; letter-spacing: 0.6px; margin-bottom: 7px; }
html.sb-narrow .side-banner .sb-text  { font-size: 0.76rem; margin-bottom: 11px; }
html.sb-narrow .side-banner select    { font-size: 0.74rem; padding: 6px 7px; margin-bottom: 11px; }
html.sb-narrow .side-banner .sb-contacts { font-size: 0.68rem; gap: 6px; padding-top: 9px; }
html.sb-narrow .side-banner .sb-contacts a { word-break: break-all; }
html.sb-narrow .side-banner--promo .promo-row { flex-direction: column; gap: 7px; }
html.sb-narrow .side-banner--promo .promo-carousel { width: 100%; }
html.sb-narrow .side-banner--promo .promo-text { font-size: 0.74rem; line-height: 1.4; }
html.sb-narrow .header-content, html.sb-narrow .header-bottom-content,
html.sb-narrow footer .container, html.sb-narrow .site-stats .container,
html.sb-narrow .site-stats .stats-grid {
    max-width: none !important;
    width: auto !important;
    margin-left: 0 !important; margin-right: 0 !important;
    padding-left: 160px !important; padding-right: 160px !important;
}

@media (min-width: 1300px) and (max-width: 1679px) {
    .side-banner {
        display: block;
        width: 145px;
        padding: 12px 10px;
        font-size: 0.8rem;
        line-height: 1.45;
        border-radius: 12px;
        max-height: calc(100vh - 190px);
    }
    .side-banner--left  { left: 3px;  transform: translateY(-50%); }
    .side-banner--right { right: 3px; transform: translateY(-50%); }
    .side-banner--promo { right: 3px; transform: none; padding: 10px 9px; }
    .side-banner .sb-label { font-size: 0.75rem; letter-spacing: 1.2px; margin-bottom: 7px; }
    .side-banner .sb-title { font-size: 1.05rem; letter-spacing: 0.6px; margin-bottom: 7px; }
    .side-banner .sb-text  { font-size: 0.76rem; margin-bottom: 11px; }
    .side-banner select    { font-size: 0.74rem; padding: 6px 7px; margin-bottom: 11px; }
    .side-banner .sb-contacts { font-size: 0.68rem; gap: 6px; padding-top: 9px; }
    .side-banner .sb-contacts a { word-break: break-all; }
    /* promo: carosello a piena larghezza, testo sotto */
    .side-banner--promo .promo-row { flex-direction: column; gap: 7px; }
    .side-banner--promo .promo-carousel { width: 100%; }
    .side-banner--promo .promo-text { font-size: 0.74rem; line-height: 1.4; }

    /* header, footer e site stats: davvero a tutta larghezza */
    .header-content, .header-bottom-content,
    footer .container, .site-stats .container,
    .site-stats .stats-grid {
        max-width: none !important;
        width: auto !important;
        margin-left: 0 !important; margin-right: 0 !important;
        padding-left: 26px !important; padding-right: 26px !important;
    }
}
/* (il layout per viewport strette è gestito dalla classe .sb-narrow sopra) */
.side-banner .sb-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--teal);
    margin-bottom: 10px;
    text-shadow: 0 0 12px rgba(50,236,195,0.5); background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.side-banner select {
    width: 100%;
    padding: 10px 12px;
    border-radius: 9px;
    border: 1px solid rgba(50,236,195,0.4);
    background: var(--input-bg, var(--surface));
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    margin-bottom: 16px;
    cursor: pointer;
    transition: border-color 0.2s;
}
.side-banner select:hover { border-color: var(--teal); }
.side-banner .sb-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.55rem;
    letter-spacing: 1.2px;
    color: var(--text-strong);
    margin: 0 0 10px;
    line-height: 1.15;
}
.side-banner .sb-text {
    color: var(--text);
    opacity: 0.85;
    font-size: 0.88rem;
    margin: 0 0 16px;
}
.side-banner .sb-contacts {
    border-top: 1px solid rgba(50,236,195,0.25);
    padding-top: 14px;
    font-size: 0.84rem;
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.side-banner .sb-contacts a {
    color: var(--teal);
    text-decoration: none;
    word-break: break-all;
    font-weight: 600; background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
.side-banner .sb-contacts a:hover { text-decoration: underline; }
.side-banner .sb-contacts span { color: var(--text-muted); }

.side-banner--left, .side-banner--right { cursor: pointer; }
.side-banner .sb-cta{position:relative;margin-top:16px;background:var(--teal-grad, var(--teal));color:#04120e;border-radius:10px;padding:7px 12px;text-align:center;font-weight:800;font-size:.84rem;letter-spacing:.3px;transition:.2s;display:flex;align-items:center;justify-content:center;gap:8px}
.side-banner .sb-cta::before{content:'';position:absolute;top:-8px;left:0;right:0;height:1px;background:rgba(50,236,195,0.25)}
.side-banner:hover .sb-cta{box-shadow:0 6px 20px rgba(50,236,195,.45);transform:translateY(-1px)}
html.sb-narrow .side-banner .sb-cta{font-size:.76rem;padding:6px 10px;margin-top:14px}

/* ── Promo banner (sotto sb-right) — compatto ──────────────── */
.side-banner--promo { right: calc((100vw - 1200px) / 4); transform: translateX(50%); cursor: pointer; padding: 12px 14px; }
.side-banner--promo .promo-a { display: block; text-decoration: none; color: var(--text); }
.side-banner--promo .sb-label { margin-bottom: 8px; }
.promo-row { display: flex; gap: 10px; align-items: flex-start; }
.promo-carousel {
    position: relative; width: 44%; flex-shrink: 0; aspect-ratio: 4 / 3;
    border-radius: 8px; overflow: hidden; background: #0a0c14;
}
.promo-slide {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: 0; transition: opacity .6s ease;
}
.promo-slide.active { opacity: 1; }
.promo-carousel { cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-drag: none; }
.promo-carousel:active { cursor: grabbing; }
.promo-slide { -webkit-user-drag: none; user-select: none; pointer-events: none; }
/* lightbox immagine promo */
#promo-lb {
    display: none; position: fixed; inset: 0; z-index: 9999;
    background: rgba(3,4,8,.92); align-items: center; justify-content: center; padding: 4vh 4vw;
    cursor: zoom-out;
}
#promo-lb.open { display: flex; }
#promo-lb img { max-width: 72vw; max-height: 80vh; border-radius: 10px; box-shadow: 0 20px 70px rgba(0,0,0,.7); }
#promo-lb-x { position: absolute; top: 18px; right: 26px; color: #fff; font-size: 2.2rem; line-height: 1; opacity: .85; cursor: pointer; }
/* ── Banner Patreon (destra) ─────────────────────────────── */
.sb-patreon .sb-title .patreon-mark, .sb-patreon .sb-contacts .patreon-mark { color: var(--text-strong); }
/* il bottone ha lo sfondo a gradiente: testo e marchio restano scuri */
.sb-patreon .sb-cta, .sb-patreon .sb-cta .patreon-mark { color: #04120e; }
.sb-perks { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 5px; }
.sb-perks li { font-size: 0.76rem; color: var(--text); opacity: .9; display: flex; gap: 7px; align-items: flex-start; line-height: 1.35; }
.sb-perks li i { color: var(--teal); font-size: 0.68rem; margin-top: 3px; }

.promo-body { flex: 1; min-width: 0; }
.promo-text { font-size: 0.8rem; color: var(--text); opacity: .88; line-height: 1.4; }
.side-banner--promo .sb-contacts { margin-top: 8px; padding-top: 10px; }
</style>

<!-- LEFT: interactive dropdown banner -->
<aside class="side-banner side-banner--left" id="sb-left" onclick="sbClickBanner('left')">
    <div class="sb-label">Need a:</div>
    <select id="sb-select" onchange="sbRenderLeft(this.value)" onclick="event.stopPropagation()"></select>
    <div id="sb-left-content"></div>
    <div class="sb-contacts" onclick="event.stopPropagation()">
        <span><i class="fa-solid fa-envelope"></i> <a href="mailto:leopartebusiness@gmail.com">leopartebusiness@gmail.com</a></span>
        <span><i class="fa-solid fa-comment"></i> Discord: <b style="color:var(--text);">leonisteam</b></span>
    </div>
    <div class="sb-cta"><i class="fab fa-discord"></i> Join my Discord server</div>
</aside>

<!-- RIGHT: Patreon. Prima era un servizio a caso, ora promuove l'abbonamento. -->
<aside class="side-banner side-banner--right sb-patreon" id="sb-right" onclick="sbClickBanner('right')">
    <div class="sb-label">LeonisTeam on Patreon</div>
    <div id="sb-right-content">
        <div class="sb-title"><svg class="patreon-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:0.95em;height:0.95em;flex:0 0 auto;vertical-align:-0.12em;"><rect x="1.6" y="2" width="4.2" height="20"/><circle cx="15.7" cy="9.6" r="7.6"/></svg> 3,500+ builds, one subscription</div>
        <p class="sb-text">The biggest Minecraft build collection ever made, and it keeps growing every week.
           Schematics, maps and asset packs ready to drop into your world — all included, no extra payment per download.</p>
        <ul class="sb-perks">
            <li><i class="fa-solid fa-check"></i> World record: 3,500+ unique builds</li>
            <li><i class="fa-solid fa-check"></i> New builds added constantly</li>
            <li><i class="fa-solid fa-check"></i> Schem, Mcstructure and map formats</li>
            <li><i class="fa-solid fa-check"></i> Cancel whenever you want</li>
        </ul>
    </div>
    <div class="sb-contacts" onclick="event.stopPropagation()">
        <span><svg class="patreon-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:0.9em;height:0.9em;flex:0 0 auto;vertical-align:-0.12em;"><rect x="1.6" y="2" width="4.2" height="20"/><circle cx="15.7" cy="9.6" r="7.6"/></svg> <a href="https://www.patreon.com/LeonisTeam" target="_blank" rel="noopener">patreon.com/LeonisTeam</a></span>
        <span><i class="fa-solid fa-comment"></i> Discord: <b style="color:var(--text);">leonisteam</b></span>
    </div>
    <div class="sb-cta"><svg class="patreon-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="width:0.95em;height:0.95em;flex:0 0 auto;vertical-align:-0.12em;"><rect x="1.6" y="2" width="4.2" height="20"/><circle cx="15.7" cy="9.6" r="7.6"/></svg> Join on Patreon</div>
</aside>


<script>
const SB_SERVICES = {
    'custom build':            { t: '<i class="fa-solid fa-trophy"></i> Need a Custom Minecraft Build?', d: "Why go anywhere else? LeonisTeam holds the world record for the most downloadable Minecraft builds ever created. 3,500+ unique builds and years in the building scene. Tell us what you want. We'll build it exactly the way you imagined." },
    'GFX designer':            { t: '<i class="fa-solid fa-palette"></i> Need a GFX Designer?', d: "Thumbnails, banners, overlays, branding. If you need graphics that actually look good and represent your project the right way, reach out. Let's make something worth showing." },
    '3D design':               { t: '<i class="fa-solid fa-cube"></i> Need a 3D Designer?', d: "Models, renders, custom assets. If you need 3D work done with precision and style, get in touch and tell us what you have in mind." },
    'photoshop artist':        { t: '<i class="fa-solid fa-image"></i> Need a Photoshop Artist?', d: "Editing, compositing, artwork, visuals. If you need someone who knows what they're doing in Photoshop and delivers clean results, reach out." },
    'pixel artist':            { t: '<i class="fa-solid fa-square"></i> Need a Pixel Artist?', d: "Sprites, icons, tilesets, assets. If you need pixel art made with care and attention to detail, get in touch and tell us what you need." },
    'SEO specialist':          { t: '<i class="fa-solid fa-chart-line"></i> Need an SEO Specialist?', d: "Rankings, visibility, organic traffic. If you want your site or content to actually be found by the right people, reach out and let's talk about what you're working on." },
    'app developer':           { t: '<i class="fa-solid fa-mobile-screen"></i> Need an App Developer?', d: "Mobile or desktop, if you have an idea and need someone to bring it to life, get in touch. Tell us what you're building and we'll figure out the rest." },
    'back end web developer':  { t: '<i class="fa-solid fa-desktop"></i> Need a Back End Developer?', d: "APIs, databases, server logic, infrastructure. If you need the engine behind your project built properly, reach out and tell us what you're working with." },
    'bot developer':           { t: '<i class="fa-solid fa-robot"></i> Need a Bot Developer?', d: "Discord bots, automation, custom commands, integrations. If you need a bot built from scratch or improved, get in touch and tell us what it needs to do." },
    'front end web developer': { t: '<i class="fa-solid fa-laptop-code"></i> Need a Front End Developer?', d: "Interfaces, layouts, responsive design, user experience. If you need something that looks good and works perfectly, reach out and let's build it." },
    'full stack developer':    { t: '<i class="fa-solid fa-gear"></i> Need a Full Stack Developer?', d: "Front end, back end, database, deployment. If you need someone who can handle the whole thing from start to finish, get in touch and tell us what you're building." },
    'game developer':          { t: '<i class="fa-solid fa-gamepad"></i> Need a Game Developer?', d: "Mechanics, systems, design, implementation. If you have a game idea or an existing project that needs work, reach out and let's talk about it." },
    'bedrock addon developer': { t: '<i class="fa-solid fa-cubes"></i> Need a Bedrock Addon Developer?', d: "Custom items, mobs, mechanics, behavior packs, resource packs. If you need a Bedrock addon built the right way, get in touch and tell us what you need." },
    'builder':                 { t: '<i class="fa-solid fa-helmet-safety"></i> Need a Minecraft Builder?', d: "Why not go straight to the best? LeonisTeam holds the world record for the most downloadable Minecraft builds ever created. 3,500+ unique builds. Whatever you need built, we can build it." },
    'configurator':            { t: '<i class="fa-solid fa-wrench"></i> Need a Configurator?', d: "Plugin configs, server settings, performance tuning. If you need your setup configured properly and efficiently, reach out and tell us what you're working with." },
    'datapack developer':      { t: '<i class="fa-solid fa-box"></i> Need a Datapack Developer?', d: "Custom mechanics, functions, advancements, loot tables. If you need a datapack built from scratch or expanded, get in touch and tell us what you want it to do." },
    'skript developer':        { t: '<i class="fa-solid fa-scroll"></i> Need a Skript Developer?', d: "Custom scripts, game mechanics, server features built with Skript. If you need it done cleanly and efficiently, reach out and tell us what you have in mind." },
    'client developer':        { t: '<i class="fa-solid fa-computer-mouse"></i> Need a Client Developer?', d: "Custom Minecraft client modifications, features, and optimizations. If you need client-side development done right, get in touch and tell us what you're building." },
    'mod developer':           { t: '<i class="fa-solid fa-gears"></i> Need a Mod Developer?', d: "Custom Forge or Fabric mods, new mechanics, items, systems. If you need a mod built from scratch or extended, reach out and tell us exactly what you want." },
    'model designer':          { t: '<i class="fa-solid fa-monument"></i> Need a Model Designer?', d: "Custom entity models, item models, block models for Minecraft or beyond. If you need models that look exactly right, get in touch and tell us what you need." },
    'organic builder':         { t: '<i class="fa-solid fa-leaf"></i> Need an Organic Builder?', d: "Trees, terrain, caves, natural structures built by hand to look truly alive. If you need organic building done with real skill and feel, reach out and let's talk." },
    'plugin developer':        { t: '<i class="fa-solid fa-plug"></i> Need a Plugin Developer?', d: "Custom Spigot or Paper plugins, new features, server mechanics. If you need a plugin built from scratch or modified to fit your needs, get in touch." },
    'render artist':           { t: '<i class="fa-solid fa-film"></i> Need a Render Artist?', d: "High quality Minecraft renders for thumbnails, showcases, promotional content. If you need visuals that stand out, reach out and tell us what you're looking for." },
    'server setup':            { t: '<i class="fa-solid fa-globe"></i> Need a Server Setup?', d: "Network configuration, spawn builds, plugins, optimization, everything from scratch. If you need a server set up properly from day one, reach out and tell us what you're building." },
    'skin designer':           { t: '<i class="fa-solid fa-user"></i> Need a Skin Designer?', d: "Custom Minecraft skins built to match your character, brand, or vision. If you need a skin that actually looks the way you imagined, get in touch." },
    'terraformer':             { t: '<i class="fa-solid fa-mountain"></i> Need a Terraformer?', d: "Custom terrain, mountains, biomes, landscapes built by hand for breathtaking worlds. If you need terraforming done at a high level, reach out and tell us what you're envisioning." },
    'texture pack artist':     { t: '<i class="fa-solid fa-palette"></i> Need a Texture Pack Artist?', d: "Custom resource packs, retextured blocks, items, UI. If you need a texture pack built from scratch or expanded, get in touch and tell us your vision." },
    'content writing':         { t: '<i class="fa-solid fa-pen-nib"></i> Need a Content Writer?', d: "Descriptions, announcements, email campaigns, website copy. If you need words that actually work and sound the way they should, reach out and tell us what you need written." },
    'translation & transcription': { t: '<i class="fa-solid fa-earth-europe"></i> Need Translation or Transcription?', d: "Accurate, natural translations and clean transcriptions for any content or format. If you need it done properly in the right language and tone, get in touch." }
};

const SB_GROUPS = {
    'Minecraft': ['custom build', 'builder', 'organic builder', 'terraformer', 'server setup', 'configurator', 'bedrock addon developer', 'datapack developer', 'skript developer', 'plugin developer', 'mod developer', 'client developer', 'skin designer', 'texture pack artist'],
    'Graphic & Design': ['GFX designer', '3D design', 'photoshop artist', 'pixel artist', 'model designer'],
    'Programming & Tech': ['app developer', 'back end web developer', 'bot developer', 'front end web developer', 'full stack developer', 'game developer'],
    'Video': ['render artist'],
    'Marketing': ['SEO specialist'],
    'Writing': ['content writing', 'translation & transcription']
};

function sbCard(key) {
    const s = SB_SERVICES[key];
    if (!s) return '';
    return '<div class="sb-title">' + s.t + '</div><p class="sb-text">' + s.d + '</p>';
}

function sbRenderLeft(key) {
    document.getElementById('sb-left-content').innerHTML = sbCard(key);
    try { localStorage.setItem('sb_service', key); } catch (e) {}
}

(function () {
    const keys = Object.keys(SB_SERVICES);

    // Populate dropdown with grouped sections
    const sel = document.getElementById('sb-select');
    Object.entries(SB_GROUPS).forEach(([group, items]) => {
        const og = document.createElement('optgroup');
        og.label = group;
        items.forEach(k => {
            if (!SB_SERVICES[k]) return;
            const o = document.createElement('option');
            o.value = k;
            o.textContent = k.charAt(0).toUpperCase() + k.slice(1);
            og.appendChild(o);
        });
        sel.appendChild(og);
    });

    // Left: restore last choice or default "custom build"
    let saved = 'custom build';
    try { saved = localStorage.getItem('sb_service') || 'custom build'; } catch (e) {}
    if (!SB_SERVICES[saved]) saved = 'custom build';
    sel.value = saved;
    sbRenderLeft(saved);

    // Il banner di destra ora e' Patreon: contenuto fisso scritto in HTML, niente da generare.

    // Stop banners above the footer while scrolling
    const sbL = document.getElementById('sb-left');
    const sbR = document.getElementById('sb-right');
    const sbP = document.getElementById('sb-promo');
    const promoSide = sbP ? (sbP.dataset.side === 'left' ? 'left' : 'right') : 'right';
    const promoAnchor = (promoSide === 'left') ? sbL : sbR;
    // Modalità "narrow": viewport < 1680 → banner ancorati al documento (absolute)
    function sbMode() {
        document.documentElement.classList.toggle('sb-narrow', window.innerWidth < 1680);
    }
    sbMode();
    window.addEventListener('resize', sbMode);

    function sbAdjust() {
        const footer = document.querySelector('footer');
        if (!footer) return;

        // narrow: banner fixed ai lati, larghezza = spazio libero accanto al contenuto
        if (document.documentElement.classList.contains('sb-narrow')) {
            const docW = document.body.clientWidth;
            const EDGE = 2, GAP = 8;
            // con lo zoom del root, i rect sono in px schermo: riporto tutto in px CSS
            const z = parseFloat(getComputedStyle(document.documentElement).zoom) || 1;
            const vh = window.innerHeight / z;

            // Larghezza banner = spazio libero accanto al contenuto centrato.
            // Se c'è la griglia (larghezza fissa e centrata) uso quella, così i
            // banner arrivano fino al bordo dei box senza vuoti.
            const cont = document.querySelector('#home-grid') || document.querySelector('.container');
            if (cont) {
                const r = cont.getBoundingClientRect();
                const cl = r.left / z + window.scrollX;
                const cr2 = r.right / z + window.scrollX;
                const side = Math.min(cl, docW - cr2);
                const avail = Math.floor(side - EDGE - GAP);
                if (avail >= 70 && avail <= 400) {
                    [sbL, sbR, sbP].forEach(el => { if (el) el.style.width = avail + 'px'; });
                }
            }

            // posizione orizzontale ai bordi, verticale centrata (fermandosi sopra il footer)
            const fTop = footer.getBoundingClientRect().top / z;
            // il banner destro riserva anche lo spazio del promo sottostante
            const reserveN = sbP ? (sbP.offsetHeight + 12) : 0;
            [sbL, sbR].forEach(el => {
                if (!el) return;
                const w = el.offsetWidth;
                const res = (el === promoAnchor) ? reserveN : 0;
                if (el === sbL) { el.style.left = EDGE + 'px'; el.style.right = 'auto'; }
                else            { el.style.left = (docW - w - EDGE) + 'px'; el.style.right = 'auto'; }
                const h = el.offsetHeight;
                let top = Math.max(12, (vh - h) / 2);
                if (top + h + 12 + res > fTop) top = fTop - h - 12 - res;
                el.style.top = top + 'px';
                el.style.transform = 'none';
            });
            if (sbP && promoAnchor) {
                sbP.style.left  = (promoSide === 'left') ? (EDGE + 'px') : ((docW - sbP.offsetWidth - EDGE) + 'px');
                sbP.style.right = 'auto';
                let ptop = (parseFloat(promoAnchor.style.top) || 0) + promoAnchor.offsetHeight + 12;
                if (ptop + sbP.offsetHeight + 12 > fTop) ptop = fTop - sbP.offsetHeight - 12;
                sbP.style.top = ptop + 'px';
                sbP.style.transform = 'none';
            }
            return;
        }

        const narrow = false;
        const fTop = footer.getBoundingClientRect().top;
        // il banner destro deve lasciare spazio anche al promo che sta sotto,
        // altrimenti fermandosi entrambi sopra il footer si sovrappongono
        const reserve = sbP ? (sbP.offsetHeight + 12) : 0;
        [[sbL, narrow ? '0' : '-50%', (promoSide === 'left' ? reserve : 0)],
         [sbR, narrow ? '0' : '50%',  (promoSide === 'left' ? 0 : reserve)]].forEach(([el, x, res]) => {
            if (!el) return;
            const bottom = window.innerHeight / 2 + el.offsetHeight / 2;
            const overlap = Math.max(0, bottom + 16 + res - fTop);
            el.style.transform = 'translate(' + x + ', calc(-50% - ' + overlap + 'px))';
        });
        // Promo banner: subito sotto sb-right, ma si ferma sopra il footer
        if (sbP && promoAnchor) {
            const rb = promoAnchor.getBoundingClientRect();
            const ph = sbP.offsetHeight;
            let ptop = rb.bottom + 12;
            // può scorrere anche oltre il bordo alto: l'importante è non entrare nel footer
            if (ptop + ph + 16 > fTop) ptop = fTop - ph - 16;
            sbP.style.top = ptop + 'px';
        }
    }
    window.addEventListener('scroll', sbAdjust, { passive: true });
    window.addEventListener('resize', sbAdjust, { passive: true });
    sbAdjust();
    // ricalcola quando cambiano le altezze (immagini caricate, contenuto random, slide)
    window.addEventListener('load', sbAdjust);
    if (window.ResizeObserver) {
        const ro = new ResizeObserver(() => sbAdjust());
        if (sbR) ro.observe(sbR);
        if (sbP) ro.observe(sbP);
    }
    [300, 900, 2000].forEach(ms => setTimeout(sbAdjust, ms));

    // Carosello immagini promo (auto + frecce manuali)
    const promoSlides = document.querySelectorAll('#sb-promo .promo-slide');
    let promoIdx = 0;
    function promoShow(n) {
        if (!promoSlides.length) return;
        promoSlides[promoIdx].classList.remove('active');
        promoIdx = (n + promoSlides.length) % promoSlides.length;
        promoSlides[promoIdx].classList.add('active');
    }
    function startPromoAuto() { clearInterval(window._promoTimer); if (promoSlides.length > 1) window._promoTimer = setInterval(() => promoShow(promoIdx + 1), 4000); }
    window.promoNav = function (dir) { promoShow(promoIdx + dir); startPromoAuto(); };
    startPromoAuto();

    // Swipe / drag sul carosello (mouse + touch). Trascinamento = cambia slide,
    // click fermo = apri lightbox. Niente onclick inline (bloccava lo swipe).
    const promoCar = document.getElementById('promo-carousel');
    if (promoCar) {
        const SWIPE = 25;
        let downX = null;

        function endSwipe(x) {
            if (downX === null) return;
            const d = x - downX;
            downX = null;
            if (Math.abs(d) > SWIPE) { if (promoSlides.length > 1) promoNav(d < 0 ? 1 : -1); }
            else { promoZoom(); }               // click fermo → lightbox
        }

        if (window.PointerEvent) {
            promoCar.addEventListener('pointerdown', e => {
                e.preventDefault(); e.stopPropagation();
                downX = e.clientX;
                try { promoCar.setPointerCapture(e.pointerId); } catch (err) {}
            });
            promoCar.addEventListener('pointerup', e => {
                e.preventDefault(); e.stopPropagation();
                endSwipe(e.clientX);
            });
            promoCar.addEventListener('pointercancel', () => { downX = null; });
        } else {
            promoCar.addEventListener('mousedown', e => { e.preventDefault(); e.stopPropagation(); downX = e.clientX; });
            document.addEventListener('mouseup', e => { if (downX !== null) endSwipe(e.clientX); });
            promoCar.addEventListener('touchstart', e => { downX = e.touches[0].clientX; }, { passive: true });
            promoCar.addEventListener('touchend',   e => endSwipe(e.changedTouches[0].clientX), { passive: true });
        }
        // il click sul carosello non deve mai aprire il link del banner
        promoCar.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); }, true);
        promoCar.addEventListener('dragstart', e => e.preventDefault());
    }

    // Lightbox immagine promo
    window.promoZoom = function () {
        const cur = document.querySelector('#promo-carousel .promo-slide.active');
        const lb = document.getElementById('promo-lb');
        if (!cur || !lb) return;
        document.getElementById('promo-lb-img').src = cur.src;
        lb.classList.add('open');
    };
    window.promoZoomClose = function () { const lb = document.getElementById('promo-lb'); if (lb) lb.classList.remove('open'); };
    document.addEventListener('keydown', e => { if (e.key === 'Escape') promoZoomClose(); });

    // ── Tracking impression/click + click-to-Discord sui banner esistenti ──
    const DISCORD = 'https://discord.gg/zGB2YQuX3Y';
    window.bTrack = function (key, ev) {
        const pg = encodeURIComponent(location.pathname.substring(0, 120));
        try { navigator.sendBeacon('/sb_ping.php?b=' + key + '&e=' + ev + '&pg=' + pg); }
        catch (e) { new Image().src = '/sb_ping.php?b=' + key + '&e=' + ev + '&pg=' + pg; }
    };
    const PATREON = 'https://www.patreon.com/LeonisTeam';
    window.sbClickBanner = function (key) {
        bTrack(key, 'click');
        // il banner di destra ora promuove Patreon: gli altri restano su Discord
        window.open(key === 'right' ? PATREON : DISCORD, '_blank', 'noopener');
    };
    // NB: le impression sono contate lato server (vedi PHP sopra), così non si
    // perdono per adblock o per chi esce prima che parta lo script. Qui solo i click.
    // Traccia anche i click sui link interni ai banner (email, discord, ecc.)
    [['sb-left','left'], ['sb-right','right'], ['sb-promo','promo']].forEach(([id, key]) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.querySelectorAll('a').forEach(a => a.addEventListener('click', () => bTrack(key, 'click')));
    });
})();
</script>
<footer data-nosnippet>
    <div class="container">
        <div class="footer-content">
            <div class="footer-section">
                <a href="index.php" style="display:inline-block;margin-bottom:12px;">
                    <img src="images/logo.png" alt="MinecraftSchem"
                         style="height:48px;width:auto;filter:drop-shadow(0 0 6px rgba(50,236,195,0.3));">
