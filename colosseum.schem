      function dlbClose(){
        document.getElementById('dlbOverlay').style.display='none';
        document.body.classList.remove('dlb-open');
      }
      document.querySelectorAll('a.vp-btn-alt-dl[target="_blank"]').forEach(a =>
        a.addEventListener('click', () => setTimeout(dlbOpen, 700)));
      document.addEventListener('keydown', e => { if (e.key === 'Escape') dlbClose(); });
