    font-weight: 600;
    transition: color 0.2s; background-image: var(--teal-grad, linear-gradient(var(--teal), var(--teal))); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }

.footer-bottom a:hover {
    color: #3fffd6;
}
</style>

<script>
/* Testo teal → gradiente del logo, SOLO dove il colore finale è il teal (#32ecc3):
   niente elementi con sfondo proprio o che contengono blocchi (il loro testo sparirebbe). */
(function () {
    const TEAL = 'rgb(50, 236, 195)';
    const INLINE_OK = /^(I|B|STRONG|EM|SMALL|SPAN|BR|SUP|SUB|U|MARK|CODE)$/;
    const SKIP = /^(INPUT|TEXTAREA|SELECT|OPTION|SVG|PATH|IMG|CANVAS|VIDEO|IFRAME|SCRIPT|STYLE|BUTTON)$/;
    function ok(el) {
        if (SKIP.test(el.tagName) || el.classList.contains('tg-text')) return false;
        // i bottoni no: hanno regole proprie sullo sfondo che cancellerebbero il testo
        if (el.closest('.btn, [class*="btn-"], .pb-load-more, .tab-button')) return false;
        const cs = getComputedStyle(el);
        if (cs.color !== TEAL || cs.backgroundImage !== 'none' || cs.backgroundColor !== 'rgba(0, 0, 0, 0)') return false;
        if (!el.textContent.trim()) return false;
        for (const c of el.querySelectorAll('*')) {
            if (!INLINE_OK.test(c.tagName)) return false;
            const cc = getComputedStyle(c);
            if (cc.backgroundColor !== 'rgba(0, 0, 0, 0)' || cc.backgroundImage !== 'none') return false;
        }
        return true;
    }
    function scan(root) {
        (root.querySelectorAll ? root.querySelectorAll('body *') : []).forEach(el => {
            // solo l'elemento più esterno teal: i figli ereditano il gradiente
            if (el.parentElement && el.parentElement.classList.contains('tg-text')) return;
            if (ok(el)) el.classList.add('tg-text');
        });
    }
    function run() { scan(document); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();
    window.addEventListener('load', run);
    // card e box caricati dopo (AJAX, view more)
    let t = null;
    new MutationObserver(() => { clearTimeout(t); t = setTimeout(run, 250); })
        .observe(document.documentElement, { childList: true, subtree: true });
})();
</script>

